name: 'Test: IPv6 route via a link-local gateway'
libraries:
  - name: 'Test Objects'
    children:
      - type: 'NetworkIPv6'
        name: 'far-net'
        inet_addr_mask:
          address: '2001:db8:1::'
          netmask: '64'
      - type: 'Firewall'
        name: 'fw-test'
        data:
          platform: 'iptables'
          host_OS: 'linux24'
          version: ''
        options:
          accept_established: false
          configure_interfaces: false
          flush_ruleset: false
          load_modules: false
          manage_virtual_addr: false
          verify_interfaces: false
        interfaces:
          - name: 'eth0'
            data:
              label: 'outside'
            addresses:
              - type: 'IPv6'
                name: 'eth0-addr6'
                inet_addr_mask:
                  address: '2001:db8::1'
                  netmask: '64'
        rule_sets:
          - type: 'Policy'
            name: 'Policy'
            ipv6: true
            top: true
            rules:
              - type: 'PolicyRule'
                action: 'Deny'
                direction: 'Both'
          - type: 'Routing'
            name: 'Routing'
            top: true
            rules:
              - type: 'RoutingRule'
                comment: 'The ordinary shape of an IPv6 route'
                rdst:
                  - 'Library:Test Objects/NetworkIPv6:far-net'
                rgtw:
                  - 'Library:Test Objects/IPv6:link-local-gw'
                ritf:
                  - 'Library:Test Objects/Firewall:fw-test/Interface:eth0'
      - type: 'IPv6'
        name: 'link-local-gw'
        inet_addr_mask:
          address: 'fe80::1'
          netmask: '128'
