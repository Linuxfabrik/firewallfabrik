name: 'Test: a negated Original Service in a NAT rule'
libraries:
  - name: 'Test Objects'
    children:
      - type: 'CustomService'
        name: 'established'
        codes:
          iptables: '-m conntrack --ctstate ESTABLISHED,RELATED'
          nftables: 'ct state established,related'
        protocol: 'any'
      - type: 'Firewall'
        name: 'fw-test'
        data:
          platform: 'iptables'
          host_OS: 'linux24'
          version: ''
        options:
          configure_interfaces: false
          flush_ruleset: false
          load_modules: false
          manage_virtual_addr: false
          verify_interfaces: false
        interfaces:
          - name: 'eth0'
            addresses:
              - type: 'IPv4'
                name: 'eth0-addr'
                inet_addr_mask:
                  address: '203.0.113.1'
                  netmask: '255.255.255.0'
          - name: 'eth1'
            addresses:
              - type: 'IPv4'
                name: 'eth1-addr'
                inet_addr_mask:
                  address: '192.168.1.1'
                  netmask: '255.255.255.0'
        rule_sets:
          - type: 'NAT'
            name: 'NAT'
            ipv4: true
            top: true
            rules:
              - type: 'NATRule'
                action: 'Translate'
                negations:
                  osrv: true
                osrc:
                  - 'Library:Test Objects/Network:internal-net'
                osrv:
                  - 'Library:Test Objects/CustomService:established'
                tsrc:
                  - 'Library:Test Objects/Firewall:fw-test/Interface:eth0/IPv4:eth0-addr'
      - type: 'Network'
        name: 'internal-net'
        inet_addr_mask:
          address: '192.168.1.0'
          netmask: '255.255.255.0'
