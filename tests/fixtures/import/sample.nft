table inet t {
  set admins { type ipv4_addr; flags interval; elements = { 192.0.2.0/24, 198.51.100.7 } }
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    ip saddr @admins tcp dport 22 accept comment "ssh admins"
    ip saddr != { 10.0.0.0/8, 172.16.0.1-172.16.0.9 } tcp dport { 80, 443, 8000-8080 } ct state new accept
    ip6 saddr 2001:db8::/32 udp sport 53 accept
    icmp type echo-request limit rate 5/second accept
    icmpv6 type { nd-neighbor-solicit, echo-request } accept
    meta l4proto { tcp, udp } th dport 53 accept
    tcp flags & (fin|syn|rst|ack) == syn counter jump svc
    iifname "eth*" oifname "ppp0" drop
    log prefix "IN drop " level info drop
    reject with tcp reset
    reject with icmpx type admin-prohibited
  }
  chain svc { meta nfproto ipv4 ip protocol gre accept; return; }
}
table ip n {
  chain pre { type nat hook prerouting priority dstnat; ip daddr 198.51.100.1 tcp dport 80 dnat to 192.168.1.10:8080; }
  chain post { type nat hook postrouting priority srcnat; oifname "eth0" masquerade; ip saddr 10.0.0.0/8 snat to 198.51.100.2; }
}
