nft_ruleset() {
    cat <<'NFT_RULES'
table inet fwf_filter {}
delete table inet fwf_filter
table ip fwf_nat {}
delete table ip fwf_nat
table ip6 fwf_nat {}
delete table ip6 fwf_nat

table inet fwf_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (global)
        #
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 2 (global)
        #
        meta nfproto ipv4 counter log prefix "RULE 2 -- DENY " level info drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (global)
        #
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 1 (global)
        #
        ip daddr 10.0.0.53 tcp dport 80 ct state new counter accept
        #
        # Rule 2 (global)
        #
        meta nfproto ipv4 counter log prefix "RULE 2 -- DENY " level info drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 2 (global)
        #
        meta nfproto ipv4 counter log prefix "RULE 2 -- DENY " level info drop
    }
}

table ip fwf_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat;
        #
        # Rule 1 (NAT)
        #
        ip daddr 198.51.100.1 tcp dport 80 counter dnat to 10.0.0.53
        #
        # Rule 2 (NAT)
        #
        ip saddr 192.168.1.0/24 counter accept
        #
        # Rule 3 (NAT)
        #
        ip daddr 10.0.0.1 tcp dport 80 counter redirect to :8080 random
        ip daddr 192.168.1.1 tcp dport 80 counter redirect to :8080 random
        ip daddr 198.51.100.1 tcp dport 80 counter redirect to :8080 random
        #
        # Rule 9 (NAT)
        #
        # Original service matches ICMP as a whole
        ip daddr 198.51.100.1 meta l4proto icmp counter dnat to 10.0.0.53
        #
        # Rule 10 (NAT)
        #
        # Original service holds more services than one -m multiport match can carry
        ip daddr 198.51.100.1 tcp dport { 5190, 1494, 709, 710, 1720, 3268, 3269, 2000, 5631, 7070, 2998, 445, 49, 548, 113, 179 } counter dnat to 10.0.0.53
        #
        # Rule 11 (NAT)
        #
        # Original destination is a host that only has a MAC address
        ether daddr 00:10:4b:de:e9:6f tcp dport 22 counter dnat to 10.0.0.53
        #
        # Rule 18 (NAT)
        #
        # Branches into a NAT rule set of its own
        counter jump NAT_branch_prerouting
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        #
        # Rule 0 (NAT)
        #
        oifname "eth0" ip saddr 192.168.1.0/24 counter snat to 198.51.100.1
        #
        # Rule 2 (NAT)
        #
        ip saddr 192.168.1.0/24 counter accept
        #
        # Rule 4 (NAT)
        #
        oifname "eth2" ip saddr 192.168.1.0/24 counter snat to 10.0.0.1
        oifname "eth0" ip saddr 192.168.1.0/24 counter snat to 198.51.100.1
        #
        # Rule 5 (NAT)
        #
        oifname "eth2" counter snat to 10.0.0.1
        oifname "eth1" counter snat to 192.168.1.1
        oifname "eth0" counter snat to 198.51.100.1
        #
        # Rule 6 (NAT)
        #
        oifname "eth2" ip daddr 10.0.0.1 counter snat to 10.0.0.1
        #
        # Rule 7 (NAT)
        #
        # Translated source is a range covering a whole prefix, plus a port range
        oifname "eth*" ip saddr 192.168.1.0/24 tcp dport 80 counter snat to 203.0.113.0-203.0.113.255:1024-2048
        #
        # Rule 8 (NAT)
        #
        # Translated source ports name an end but no start
        oifname "eth0" ip saddr 192.168.1.0/24 tcp dport 443 counter snat to 198.51.100.1:0-1024
        #
        # Rule 13 (NAT)
        #
        # Asks for the MASQUERADE target instead of SNAT
        oifname "eth0" ip saddr 192.168.1.0/24 counter masquerade
        #
        # Rule 14 (NAT)
        #
        # Masquerades into a source port range, with an original service that names no protocol
        oifname "eth0" ip saddr 192.168.1.0/24 meta skuid 500 meta l4proto tcp counter masquerade to :61000-65095
        #
        # Rule 15 (NAT)
        #
        # Maps a whole network 1:1, with an original service that names no protocol
        ip saddr 192.168.1.0/24 meta skuid 500 counter snat prefix to 198.51.100.0/24
        #
        # Rule 16 (NAT)
        #
        # Original source is an address range that is no prefix
        oifname "eth0" ip saddr 192.168.1.100-192.168.1.200 counter snat to 198.51.100.1
        #
        # Rule 17 (NAT)
        #
        # Original service names two connection owners
        oifname "eth0" meta skuid 500 counter snat to 198.51.100.1
        oifname "eth0" meta skuid 501 counter snat to 198.51.100.1
    }

    chain NAT_branch_prerouting {
        #
        # Rule NAT_branch 0 (NAT)
        #
        tcp dport 80 counter dnat to 10.0.0.53
    }
}

table ip6 fwf_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat;
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
    }

    chain NAT_ipv6_prerouting {
        #
        # Rule NAT_ipv6 0 (NAT)
        #
        # Original service matches fragmented packets
        ip6 daddr 2001:db8:1::1 frag more-fragments 1 counter dnat to 2001:db8:3::53
    }
}

NFT_RULES
}

# nft parses and evaluates the whole batch before it installs anything, and
# refuses all of it over a single bad rule.  Asking first, while the running
# ruleset is still in place, is what keeps a rejected ruleset from turning
# into a firewall with no rules at all: the check touches nothing.
check_ruleset() {
    nft_ruleset | $NFT --check -f /dev/stdin
}

script_body() {
    nft_ruleset | $NFT -f /dev/stdin
}

ip_forward() {
    :
    echo 1 > /proc/sys/net/ipv4/ip_forward
}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
    $NFT delete table inet fwf_mangle 2>/dev/null
    $NFT delete table ip fwf_mangle 2>/dev/null
    # Deleting a table that is not there fails, and most firewalls have no
    # mangle table, so without this the function would hand its caller the
    # exit code of a failed delete and "stop" would report failure.
    return 0
}

# The tables this ruleset installs, in the form "nft list tables" prints.
FWF_OWN_TABLES='table inet fwf_filter
table ip fwf_nat
table ip6 fwf_nat'

# Everything else, removed once the new ruleset is in place.
#
# nft loads a ruleset atomically and the one above deletes and recreates
# each of its own tables in that same transaction, so their rules are
# never missing for an instant.  Removing the old rules first undoes
# exactly that: a table that is gone hooks nothing and every packet goes
# through, and the machine has no firewall at all until the load
# finishes.  The iptables side has no such gap - its reset sets the three
# built-in policies to DROP before it flushes anything - and this is what
# gives nftables the same guarantee.
#
# The deletes go into one batch of their own, so a name that has to be
# quoted survives the round trip through "nft list tables" untouched.
remove_other_tables() {
    $NFT list tables 2>/dev/null |
        while read -r line; do
            printf '%s\n' "$FWF_OWN_TABLES" | grep -qxF "$line" && continue
            printf 'delete %s\n' "$line"
        done |
        $NFT -f - 2>/dev/null
    flush_legacy_iptables
    return 0
}

flush_legacy_iptables() {
    # Remove stale legacy (xtables) iptables rules left over from a
    # previous iptables-based policy. "nft flush ruleset" only clears
    # the nft backend, so on systems still using the legacy backend the
    # old iptables rules would otherwise survive and shadow the nft
    # rules. All filtering is delegated to nftables, so the built-in
    # policies are reset to ACCEPT and every chain is flushed/deleted.
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -P INPUT ACCEPT 2>/dev/null
        "$ipt" -P FORWARD ACCEPT 2>/dev/null
        "$ipt" -P OUTPUT ACCEPT 2>/dev/null
        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -F 2>/dev/null
            "$ipt" -t "$table" -X 2>/dev/null
        done
    done
    # Same as in flush_own_tables: a table the kernel does not offer makes
    # the last command fail, which must not become the caller's exit code.
    return 0
}

block_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
}

stop_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_tools
        prolog_commands
        configure_interfaces
        verify_interfaces
        check_ruleset || {
            log "Ruleset rejected by nft, keeping the running firewall"
            run_epilog_and_exit 1
        }
        script_body || run_epilog_and_exit 1
        remove_other_tables
        ip_forward
        epilog_commands
        log "Firewall script is done"
        ;;

    stop)
        check_tools
        stop_action
        RETVAL=$?
        ;;

    status)
        check_tools
        status_action
        RETVAL=$?
        ;;

    block)
        check_tools
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 start
        RETVAL=$?
        ;;

    interfaces)
        configure_interfaces
        RETVAL=$?
        ;;

    test_interfaces)
        FWBDEBUG="echo"
        configure_interfaces
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload|interfaces|test_interfaces]"
        RETVAL=1
        ;;

esac

exit "$RETVAL"
