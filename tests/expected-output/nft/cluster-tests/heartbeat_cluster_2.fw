#!/bin/sh
#
#  This file is managed by FirewallFabrik - do not edit
#
#  FirewallFabrik fwf-nft VERSION
#
#  Generated TIMESTAMP
#
# files: * heartbeat_cluster_2.fw /etc/fwf.sh
#
#  This is an example of linux/heartbeat cluster with two policy rule sets. Branching rule in the top policy passes control to rule set to_fw, which is different in member firewalls.  See ticket #372 for explanation.

#  same as heartbeat_cluster_1 except using unicast for conntrack and heartbeat
#

FWBDEBUG=""

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="/usr/sbin/nft"
IP="ip"
LOGGER="logger"

log() {
    echo "$1"
    command -v logger > /dev/null 2>&1 && logger -p info "$1"
}

check_nft() {
    if [ ! -x "$NFT" ]; then
        echo "Error: nft not found at $NFT"
        exit 1
    fi
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

nft_ruleset() {
    cat <<'NFT_RULES'
table ip fwf_filter {}
delete table ip fwf_filter
table ip fwf_nat {}
delete table ip fwf_nat

table ip fwf_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (eth0)
        #
        iifname "eth0" ip daddr 224.0.0.18 meta l4proto 112 ct state new counter accept
        #
        # Rule 1 (eth0)
        #
        # anti spoofing rule
        iifname "eth0" ip saddr { 172.24.0.1, 192.168.1.1, 192.168.1.0/24 } ct state new counter log prefix "RULE 1 -- DENY " level info drop
        #
        # Rule 2 (lo)
        #
        iif "lo" ct state new counter accept
        #
        # Rule 3 (global)
        #
        # SSH Access to firewall is permitted
        # only from internal network
        ip saddr 192.168.1.0/24 tcp dport 22 ct state new counter accept
        #
        # Rule 6 (global)
        #
        # branch rule set is different in members linux-1 and linux-2
        counter jump to_fw
        #
        # Rule 8 (global)
        #
        counter log prefix "RULE 8 -- DENY " level info drop
        #
        # Rule 9 (global)
        #
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 10 (global)
        #
        ct state new counter log prefix "RULE 10 -- DENY " level info drop
        #
        # Rule 11 (global)
        #
        counter log prefix "RULE 11 -- DENY " level info drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (eth0)
        #
        oifname "eth0" ip daddr 224.0.0.18 meta l4proto 112 ct state new counter accept
        #
        # Rule 1 (eth0)
        #
        # anti spoofing rule
        iifname "eth0" ip saddr { 172.24.0.1, 192.168.1.1, 192.168.1.0/24 } ct state new counter log prefix "RULE 1 -- DENY " level info drop
        #
        # Rule 4 (global)
        #
        # SSH Access to firewall is permitted
        # only from internal network
        ip saddr 192.168.1.0/24 ip daddr { 192.168.1.2, 192.168.1.3 } tcp dport 22 ct state new counter accept
        #
        # Rule 7 (global)
        #
        # branch rule set is different in members linux-1 and linux-2
        ip daddr { 172.24.0.2, 192.168.1.2, 192.168.100.1 } counter jump to_fw
        #
        # Rule 9 (global)
        #
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 10 (global)
        #
        ct state new counter log prefix "RULE 10 -- DENY " level info drop
        #
        # Rule 11 (global)
        #
        counter log prefix "RULE 11 -- DENY " level info drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (eth0)
        #
        oifname "eth0" ip daddr 224.0.0.18 meta l4proto 112 ct state new counter accept
        #
        # Rule 2 (lo)
        #
        oif "lo" ct state new counter accept
        #
        # Rule 4 (global)
        #
        # SSH Access to firewall is permitted
        # only from internal network
        ip saddr 192.168.1.0/24 ip daddr { 192.168.1.2, 192.168.1.3 } tcp dport 22 ct state new counter accept
        #
        # Rule 5 (global)
        #
        # Firewall uses one of the machines
        # on internal network for DNS
        ip daddr 192.168.1.0/24 meta l4proto { tcp, udp } th dport 53 ct state new counter log prefix "RULE 5 -- ACCEPT " level info accept
        #
        # Rule 6 (global)
        #
        # branch rule set is different in members linux-1 and linux-2
        ip daddr { 172.24.0.1, 192.168.1.1 } counter jump to_fw
        #
        # Rule 7 (global)
        #
        # branch rule set is different in members linux-1 and linux-2
        ip daddr { 172.24.0.2, 192.168.1.2, 192.168.100.1 } counter jump to_fw
        #
        # Rule 8 (global)
        #
        ip daddr { 172.24.0.1, 192.168.1.1 } counter log prefix "RULE 8 -- DENY " level info drop
        #
        # Rule 9 (global)
        #
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 10 (global)
        #
        ct state new counter log prefix "RULE 10 -- DENY " level info drop
        #
        # Rule 11 (global)
        #
        counter log prefix "RULE 11 -- DENY " level info drop
    }

    chain to_fw {
    }
}

table ip fwf_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat;
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        #
        # Rule 0 (NAT)
        #
        oifname "eth0" ip saddr 192.168.1.0/24 counter snat to 172.24.0.1
        #
        # Rule 1 (NAT)
        #
        oifname "eth0" ip saddr 192.168.1.0/24 counter snat to 172.24.0.1
    }
}

NFT_RULES
}

# nft parses and evaluates the whole batch before it installs anything, and
# refuses all of it over a single bad rule.  Asking first, while the running
# ruleset is still in place, is what keeps a rejected ruleset from turning
# into a firewall with no rules at all: the check touches nothing.
check_ruleset() {
    nft_ruleset | $NFT --check -f /dev/stdin
}

script_body() {
    nft_ruleset | $NFT -f /dev/stdin
}

routing_script() {
    $IP route add 172.24.1.0/24 via 172.24.0.100 dev eth0

}

ip_forward() {
    :

}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
    $NFT delete table inet fwf_mangle 2>/dev/null
    $NFT delete table ip fwf_mangle 2>/dev/null
    # Deleting a table that is not there fails, and most firewalls have no
    # mangle table, so without this the function would hand its caller the
    # exit code of a failed delete and "stop" would report failure.
    return 0
}

flush_legacy_iptables() {
    # Remove stale legacy (xtables) iptables rules left over from a
    # previous iptables-based policy. "nft flush ruleset" only clears
    # the nft backend, so on systems still using the legacy backend the
    # old iptables rules would otherwise survive and shadow the nft
    # rules. All filtering is delegated to nftables, so the built-in
    # policies are reset to ACCEPT and every chain is flushed/deleted.
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -P INPUT ACCEPT 2>/dev/null
        "$ipt" -P FORWARD ACCEPT 2>/dev/null
        "$ipt" -P OUTPUT ACCEPT 2>/dev/null
        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -F 2>/dev/null
            "$ipt" -t "$table" -X 2>/dev/null
        done
    done
    # Same as in flush_own_tables: a table the kernel does not offer makes
    # the last command fail, which must not become the caller's exit code.
    return 0
}

block_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
}

stop_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_nft
        prolog_commands
        check_ruleset || {
            log "Ruleset rejected by nft, keeping the running firewall"
            run_epilog_and_exit 1
        }
        stop_action
        script_body || run_epilog_and_exit 1
        routing_script
        ip_forward
        RETVAL=$?
        epilog_commands
        log "Firewall script is done"
        ;;

    stop)
        check_nft
        stop_action
        RETVAL=$?
        ;;

    status)
        check_nft
        status_action
        RETVAL=$?
        ;;

    block)
        check_nft
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 stop
        $0 start
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload]"
        ;;

esac

exit "$RETVAL"
