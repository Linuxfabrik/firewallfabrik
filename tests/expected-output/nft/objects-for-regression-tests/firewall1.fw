        oifname "eth0" ip saddr { 22.22.22.22, 192.168.1.1 } ip daddr != { 22.22.22.22, 192.168.1.1 } meta l4proto 50 meter htable_Policy_0 { ip saddr timeout 3600s limit rate 1/hour burst 2 packets } counter log level debug drop
        #
        # Rule 1 (eth0)
        #
        iifname "eth0" ip saddr { 192.168.1.10, 192.168.1.20 } ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto 1 meter htable_Policy_1 { ip daddr timeout 3600s limit rate 1/hour burst 2 packets } counter drop
        iifname "eth0" ip saddr { 192.168.1.10, 192.168.1.20 } ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto 50 meter htable_Policy_1 { ip daddr timeout 3600s limit rate 1/hour burst 2 packets } counter drop
        oifname "eth0" ip saddr { 192.168.1.10, 192.168.1.20 } ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto 1 meter htable_Policy_1 { ip daddr timeout 3600s limit rate 1/hour burst 2 packets } counter drop
        oifname "eth0" ip saddr { 192.168.1.10, 192.168.1.20 } ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto 50 meter htable_Policy_1 { ip daddr timeout 3600s limit rate 1/hour burst 2 packets } counter drop
        #
