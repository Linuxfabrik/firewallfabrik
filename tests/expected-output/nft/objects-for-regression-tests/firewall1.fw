        # double negation rule
        ip daddr != { 192.168.1.10, 192.168.1.20 } tcp dport != { 3128, 8080 } counter log level debug drop
        #
        # Rule 36 (global)
        #
        ip daddr != { 192.168.1.1, 192.168.2.1 } ct state new counter accept
        #
        # Rule 37 (global)
        #
        ip daddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 40 (global)
        #
        ip saddr { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1 } ip daddr != 192.168.1.0/24 tcp dport 80 counter drop
        #
        # Rule 41 (global)
        #
        ip saddr != 192.168.1.0/24 tcp dport 80 counter drop
    }

    chain forward {
