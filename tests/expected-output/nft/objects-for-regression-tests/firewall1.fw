#!/bin/sh
#
#  This file is managed by FirewallFabrik - do not edit
#
#  FirewallFabrik fwf-nft VERSION
#
#  Generated TIMESTAMP
#
# files: * firewall1.fw /etc/fw/firewall1.fw
#
#  this object is used to test all kinds of negation in policy and NAT rules.
#  Assume firewall is part of any is ON
#
# Rule 30 (global): A negated time that names both a time of day and a weekday needs two rules to say "outside those hours or on another day", which nftables cannot express in one; the rule is left out
# Rule 31 (global): A negated time that names both a time of day and a weekday needs two rules to say "outside those hours or on another day", which nftables cannot express in one; the rule is left out
# Rule 38 (global): A negated time that names both a time of day and a weekday needs two rules to say "outside those hours or on another day", which nftables cannot express in one; the rule is left out
# Rule 39 (global): A negated time that names both a time of day and a weekday needs two rules to say "outside those hours or on another day", which nftables cannot express in one; the rule is left out
# Rule '5 (eth2)' shadows rule '6 (eth2)' below it
# firewall1:Policy:29: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
# firewall1:Policy:30: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
# firewall1:Policy:31: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
# firewall1:Policy:38: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
# firewall1:Policy:39: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees

FWBDEBUG=""
# Every branch of the case below is expected to leave an exit code here, and
# the one that prints the usage says 1.  Without the initialisation the
# script ends in `exit ""`, which the shell answers with "numeric argument
# required" and an exit code of its own choosing.  The iptables skeleton has
# had both lines since fwbuilder wrote it.
RETVAL=0

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="/usr/sbin/nft"
IP="ip"
LOGGER="logger"

log() {
    echo "$1"
    command -v "$LOGGER" >/dev/null 2>&1 && $LOGGER -p info "$1"
}

getInterfaceVarName() {
    echo "$1" | sed 's/\./_/'
}

getaddr_internal() {
    dev=$1
    name=$2
    af=$3
    L=$("$IP" "$af" addr show dev "$dev" | sed -n '/inet/{s!.*inet6* !!;s!/.*!!p}' | sed 's/peer.*//')
    test -z "$L" && {
        eval "$name=''"
        return
    }
    eval "${name}_list=\"$L\""
}

getnet_internal() {
    dev=$1
    name=$2
    af=$3
    L=$("$IP" route list proto kernel | grep "$dev" | grep -v default | sed 's! .*$!!')
    test -z "$L" && {
        eval "$name=''"
        return
    }
    eval "${name}_list=\"$L\""
}

getaddr() {
    getaddr_internal "$1" "$2" "-4"
}

getaddr6() {
    getaddr_internal "$1" "$2" "-6"
}

getnet() {
    getnet_internal "$1" "$2" "-4"
}

getnet6() {
    getnet_internal "$1" "$2" "-6"
}

# function getinterfaces is used to process wildcard interfaces
getinterfaces() {
    NAME=$1
    "$IP" link show | grep ": $NAME" | while read -r L; do
        OIFS=$IFS
        IFS=" :"
        # shellcheck disable=SC2086
        set -- $L
        IFS=$OIFS
        echo "$2"
    done
}

diff_intf() {
    func=$1
    list1=$2
    list2=$3
    cmd=$4
    for intf in $list1
    do
        echo "$list2" | grep -q "$intf" || {
        # $intf is absent in list 2
            "$func" "$intf" "$cmd"
        }
    done
}

P2P_INTERFACE_WARNING=""

missing_address() {
    address=$1
    cmd=$2

    oldIFS=$IFS
    IFS="@"
    # shellcheck disable=SC2086
    set -- $address
    addr=$1
    interface=$2
    IFS=$oldIFS

    "$IP" addr show dev "$interface" | grep -q POINTOPOINT && {
        test -z "$P2P_INTERFACE_WARNING" && echo "Warning: Can not update address of interface $interface. fwbuilder can not manage addresses of point-to-point interfaces yet"
        P2P_INTERFACE_WARNING="yes"
        return
    }

    test "$cmd" = "add" && {
      echo "# Adding ip address: $interface $addr"
      if echo "$addr" | grep -q ':'; then
          $FWBDEBUG "$IP" addr "$cmd" "$addr" dev "$interface"
      else
          $FWBDEBUG "$IP" addr "$cmd" "$addr" broadcast + dev "$interface"
      fi
    }

    test "$cmd" = "del" && {
      echo "# Removing ip address: $interface $addr"
      $FWBDEBUG "$IP" addr "$cmd" "$addr" dev "$interface" || exit 1
    }

    $FWBDEBUG "$IP" link set "$interface" up
}

list_addresses_by_scope() {
    interface=$1
    scope=$2
    ignore_list=$3
    "$IP" addr ls dev "$interface" | \
      awk -v IGNORED="$ignore_list" -v SCOPE="$scope" \
        'BEGIN {
           split(IGNORED,ignored_arr);
           for (a in ignored_arr) {ignored_dict[ignored_arr[a]]=1;}
         }
         (/inet |inet6 / && $0 ~ SCOPE && !($2 in ignored_dict)) {print $2;}' | \
        while read -r addr; do
          echo "${addr}@$interface"
	done | sort
}

update_addresses_of_interface() {
    ignore_list=$2
    # shellcheck disable=SC2086
    set -- $1
    interface=$1
    shift

    FWB_ADDRS=$(
      for addr in "$@"; do
        echo "${addr}@$interface"
      done | sort
    )

    CURRENT_ADDRS_ALL_SCOPES=""
    CURRENT_ADDRS_GLOBAL_SCOPE=""

    if "$IP" link show dev "$interface" >/dev/null 2>&1; then
      CURRENT_ADDRS_ALL_SCOPES=$(list_addresses_by_scope "$interface" 'scope .*' "$ignore_list")
      CURRENT_ADDRS_GLOBAL_SCOPE=$(list_addresses_by_scope "$interface" 'scope global' "$ignore_list")
    else
      echo "# Interface $interface does not exist"
      # Stop the script if we are not in test mode
      test -z "$FWBDEBUG" && exit 1
    fi

    diff_intf missing_address "$FWB_ADDRS" "$CURRENT_ADDRS_ALL_SCOPES" add
    diff_intf missing_address "$CURRENT_ADDRS_GLOBAL_SCOPE" "$FWB_ADDRS" del
}

clear_addresses_except_known_interfaces() {
    "$IP" link show | sed 's/://g' | awk -v IGNORED="$*" \
        'BEGIN {
           split(IGNORED,ignored_arr);
           for (a in ignored_arr) {ignored_dict[ignored_arr[a]]=1;}
         }
         (/state/ && !($2 in ignored_dict)) {print $2;}' | \
         while read -r intf; do
            echo "# Removing addresses not configured in fwbuilder from interface $intf"
            $FWBDEBUG "$IP" addr flush dev "$intf" scope global
            $FWBDEBUG "$IP" link set "$intf" down
         done
}

check_nft() {
    if [ ! -x "$NFT" ]; then
        echo "Error: nft not found at $NFT"
        exit 1
    fi
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

configure_interfaces() {
    :
    # See http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=429689
    # this ensures that secondary ip address is "promoted" to primary
    # when primary address is deleted, instead of deleting both
    # primary and secondary addresses. It looks like this is only
    # available starting from Linux 2.6.16
    test -f /proc/sys/net/ipv4/conf/all/promote_secondaries && \
        echo 1 >  /proc/sys/net/ipv4/conf/all/promote_secondaries
    update_addresses_of_interface "eth0 192.168.1.1/24 192.168.1.0/24" ""
    update_addresses_of_interface "eth1 22.22.22.22/24 22.22.22.23/24" ""
    update_addresses_of_interface "eth2 192.168.2.1/24 192.168.2.0/24" ""
    update_addresses_of_interface "eth3 22.22.23.23/24" ""
    update_addresses_of_interface "lo 127.0.0.1/8" ""
}

nft_ruleset() {
    cat <<'NFT_RULES'
table ip fwf_filter {}
delete table ip fwf_filter
table ip fwf_nat {}
delete table ip fwf_nat

table ip fwf_filter {
    counter RULE_11 {
    }
    counter RULE_17 {
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        #
        # Rule 0 (eth0)
        #
        iifname "eth0" ip saddr { 22.22.22.22, 192.168.1.1 } ip daddr != { 22.22.22.22, 192.168.1.1 } meta l4proto 1 meter htable_Policy_0 { ip saddr timeout 3600s limit rate 1/hour burst 2 packets } counter log level debug drop
        iifname "eth0" ip saddr { 22.22.22.22, 192.168.1.1 } ip daddr != { 22.22.22.22, 192.168.1.1 } meta l4proto 50 meter htable_Policy_0 { ip saddr timeout 3600s limit rate 1/hour burst 2 packets } counter log level debug drop
        #
        # Rule 1 (eth0)
        #
        iifname "eth0" ip saddr { 192.168.1.10, 192.168.1.20 } ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto 1 meter htable_Policy_1 { ip daddr timeout 3600s limit rate 1/hour burst 2 packets } counter drop
        iifname "eth0" ip saddr { 192.168.1.10, 192.168.1.20 } ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto 50 meter htable_Policy_1 { ip daddr timeout 3600s limit rate 1/hour burst 2 packets } counter drop
        #
        # Rule 2 (eth1)
        #
        # Anti-spoofing rule
        iifname "eth1" ip saddr { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1, 192.168.1.0/24 } counter log level debug drop
        #
        # Rule 5 (eth2)
        #
        iifname "eth2" ip saddr 192.168.2.0/24 ct state new counter accept
        #
        # Rule 6 (eth2)
        #
        iifname != "eth2" ip saddr 192.168.2.0/24 counter log level debug drop
        #
        # Rule 7 (eth1,eth3)
        #
        iifname "eth0" ip saddr { 22.22.23.128/25, 33.33.33.0/24 } counter log level debug drop
        iifname "eth2" ip saddr { 22.22.23.128/25, 33.33.33.0/24 } counter log level debug drop
        #
        # Rule 8 (lo)
        #
        iif "lo" ct state new counter accept
        #
        # Rule 9 (eth0,eth2)
        #
        iifname "eth0" ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } counter log level debug drop
        iifname "eth2" ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } counter log level debug drop
        #
        # Rule 10 (eth1,eth3)
        #
        iifname "eth1" ip saddr != { 22.22.23.128/25, 33.33.33.0/24 } ct state new counter accept
        iifname "eth3" ip saddr != { 22.22.23.128/25, 33.33.33.0/24 } ct state new counter accept
        #
        # Rule 11 (global)
        #
        counter name "RULE_11"
        #
        # Rule 12 (global)
        #
        tcp flags syn / syn,rst,ack counter log level debug drop
        #
        # Rule 13 (global)
        #
        tcp flags & (syn | rst | ack) != syn counter log level debug drop
        #
        # Rule 15 (global)
        #
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } ct state new counter accept
        #
        # Rule 16 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } icmp type destination-unreachable limit rate 10/minute counter log level debug drop
        #
        # Rule 17 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } tcp dport { 80, 443 } limit rate 10/minute counter name "RULE_17" log level debug
        #
        # Rule 18 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } tcp dport { 80, 443 } ct state new limit rate 10/minute counter log level debug accept
        #
        # Rule 19 (global)
        #
        ip saddr != { 192.168.1.10, 192.168.1.20 } icmp type destination-unreachable counter log level debug drop
        #
        # Rule 20 (global)
        #
        ip saddr != 192.168.2.0/24 ip daddr 192.168.1.0/24 counter log level debug drop
        #
        # Rule 21 (global)
        #
        ip saddr != 192.168.2.0/24 ip daddr 192.168.1.0/24 counter log level debug drop
        #
