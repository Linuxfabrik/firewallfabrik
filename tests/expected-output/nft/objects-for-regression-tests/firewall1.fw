        #
        # Rule 25 (global)
        #
        # testing negation in service field
        ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport != { 25, 22 } ct state new counter log level debug accept
        #
        # Rule 26 (global)
        #
        # testing negation in service field
