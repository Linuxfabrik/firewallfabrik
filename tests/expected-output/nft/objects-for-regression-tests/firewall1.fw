        #
        # Rule 29 (global)
        #
        # testing negation in service field
        # firewall1:Policy:29: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
        ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport != 80 ct state new meta hour 32400-61200 meta day { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" } counter accept
        #
        # Rule 33 (global)
        #
        ip saddr 192.168.2.0/24 ip daddr != 192.168.1.0/24 tcp dport 22 ct state new counter accept
        #
        # Rule 34 (global)
        #
        ip saddr { 22.22.22.22, 192.168.1.1 } ip daddr != { 22.22.22.22, 192.168.1.1 } meta l4proto 1 counter log level debug drop
        ip saddr { 22.22.22.22, 192.168.1.1 } ip daddr != { 22.22.22.22, 192.168.1.1 } meta l4proto 50 counter log level debug drop
        #
        # Rule 35 (global)
        #
        # double negation rule
        ip daddr != { 192.168.1.10, 192.168.1.20 } tcp dport != { 3128, 8080 } counter log level debug drop
        #
        # Rule 36 (global)
        #
        ct state new counter accept
        #
        # Rule 37 (global)
        #
        ip daddr 192.168.1.0/24 ct state new counter accept
    }

    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        #
        # Rule 3 (eth1)
        #
        # Anti-spoofing rule
        oifname "eth1" ip saddr != 192.168.1.0/24 counter log level debug drop
        #
        # Rule 4 (eth1)
        #
        # Anti-spoofing rule
        oifname "eth1" ip saddr != { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1 } counter log level debug drop
        #
        # Rule 5 (eth2)
        #
        oifname "eth2" ip saddr 192.168.2.0/24 ct state new counter accept
        #
        # Rule 8 (lo)
        #
        oif "lo" ct state new counter accept
        #
        # Rule 11 (global)
        #
        counter name "RULE_11"
        #
        # Rule 12 (global)
        #
        tcp flags syn / syn,rst,ack counter log level debug drop
        #
        # Rule 13 (global)
        #
        tcp flags & (syn | rst | ack) != syn counter log level debug drop
        #
        # Rule 14 (global)
        #
        # hostF has the same IP address as firewal.
        ip daddr 192.168.1.1 icmp type echo-request icmp code 0 ct state new counter log level debug accept
        #
        # Rule 15 (global)
        #
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } ct state new counter accept
        #
        # Rule 16 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } icmp type destination-unreachable limit rate 10/minute counter log level debug drop
        #
        # Rule 17 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } tcp dport { 80, 443 } limit rate 10/minute counter name "RULE_17" log level debug
        #
        # Rule 18 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } tcp dport { 80, 443 } ct state new limit rate 10/minute counter log level debug accept
        #
        # Rule 19 (global)
        #
        ip saddr != { 192.168.1.10, 192.168.1.20 } ip daddr { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1 } icmp type destination-unreachable counter log level debug drop
        #
        # Rule 20 (global)
        #
        ip saddr != { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1 } ip daddr 192.168.1.0/24 counter log level debug drop
        #
        # Rule 21 (global)
        #
        ip saddr != 192.168.1.1 ip daddr 192.168.1.0/24 counter log level debug drop
        #
        # Rule 23 (global)
        #
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr != { 192.168.1.10, 192.168.1.20 } counter log level debug drop
        #
        # Rule 24 (global)
        #
        # testing negation in service field
        ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport != { 25, 22 } counter log level debug drop
        #
        # Rule 25 (global)
        #
        # testing negation in service field
        ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport != { 25, 22 } ct state new counter log level debug accept
        #
        # Rule 26 (global)
        #
        # testing negation in service field
        ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport != 25 ct state new counter log level debug accept
        #
        # Rule 27 (global)
        #
        # testing negation in service field
        ip daddr { 192.168.1.10, 192.168.1.20 } meta l4proto != icmp ct state new counter log level debug accept
        #
        # Rule 28 (global)
        #
        # testing negation in service field
        ip daddr != { 192.168.1.10, 192.168.1.20 } meta l4proto != icmp ct state new counter accept
        #
        # Rule 29 (global)
        #
        # testing negation in service field
        # firewall1:Policy:29: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
        ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport != 80 ct state new meta hour 32400-61200 meta day { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" } counter accept
        #
        # Rule 32 (global)
        #
        tcp dport 80 ct state new counter accept
        #
        # Rule 33 (global)
        #
        ip daddr != 192.168.1.0/24 tcp dport 22 ct state new counter accept
        ip saddr 192.168.2.0/24 ip daddr != 192.168.1.0/24 tcp dport 22 ct state new counter accept
        #
        # Rule 35 (global)
        #
        # double negation rule
        ip daddr != { 192.168.1.10, 192.168.1.20 } tcp dport != { 3128, 8080 } counter log level debug drop
        #
        # Rule 36 (global)
        #
        ct state new counter accept
        #
        # Rule 37 (global)
        #
        ip saddr != { 192.168.1.1, 192.168.2.1 } ip daddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 40 (global)
        #
        ip daddr != 192.168.1.0/24 tcp dport 80 counter drop
        #
        # Rule 41 (global)
        #
        ip saddr != 192.168.1.0/24 ip daddr { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1 } tcp dport 80 counter drop
    }

    chain GOOD_GUYS {
        #
        # Rule GOOD_GUYS 0 (global)
        #
        ip saddr != { 1.1.1.0/24, 192.168.1.0/24 } counter log level debug drop
    }
}

table ip fwf_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat;
        #
        # Rule 0 (NAT)
        #
        ip saddr 192.168.1.0/24 ip daddr 192.168.2.0/24 counter accept
        #
        # Rule 11 (NAT)
        #
        ip saddr 192.168.1.0/24 ip daddr != { 22.22.22.22, 22.22.23.23, 192.168.1.1, 192.168.2.1 } tcp dport 80 counter redirect to :3128
        #
        # Rule 12 (NAT)
        #
        ip saddr 192.168.1.0/24 ip daddr != 192.168.1.1 tcp dport 80 counter redirect to :3128
        #
        # Rule 13 (NAT)
        #
        ip saddr 192.168.1.10 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } tcp dport 80 counter redirect to :3128
        ip saddr 192.168.1.20 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } tcp dport 80 counter redirect to :3128
        #
        # Rule 14 (NAT)
        #
        ip saddr != { 192.168.1.10, 192.168.1.20 } ip daddr 192.168.1.0/24 tcp dport 80 counter redirect to :3128
        ip saddr != { 192.168.1.10, 192.168.1.20 } ip daddr 192.168.2.0/24 tcp dport 80 counter redirect to :3128
        #
        # Rule 15 (NAT)
        #
        ip saddr != 192.168.1.10 tcp dport 80 counter redirect to :3128
        #
        # Rule 16 (NAT)
        #
        ip daddr 22.22.22.23 tcp sport 5000 tcp dport 5000-5010 counter dnat to 192.168.1.10
        ip daddr 22.22.22.23 tcp sport 9000 counter dnat to 192.168.1.10
        ip daddr 22.22.22.23 tcp dport { 6667, 3128, 4000-4010 } counter dnat to 192.168.1.10
        #
        # Rule 17 (NAT)
        #
        ip daddr 192.168.1.0/24 tcp dport 80 counter dnat to :3128
        ip daddr 192.168.2.0/24 tcp dport 80 counter dnat to :3128
        #
        # Rule 18 (NAT)
        #
        ip daddr != 192.168.1.0/24 tcp dport 80 counter dnat to :3128
        ip daddr != 192.168.2.0/24 tcp dport 80 counter dnat to :3128
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        #
        # Rule 0 (NAT)
        #
        ip saddr 192.168.1.0/24 ip daddr 192.168.2.0/24 counter accept
        #
        # Rule 1 (NAT)
        #
        oifname "eth0" ip saddr 192.168.1.10 counter snat to 22.22.22.23
        oifname "eth1" ip saddr 192.168.1.10 counter snat to 22.22.22.23
        oifname "eth2" ip saddr 192.168.1.10 counter snat to 22.22.22.23
        oifname "eth3" ip saddr 192.168.1.10 counter snat to 22.22.22.23
        #
        # Rule 2 (NAT)
        #
        oifname "eth0" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 counter snat to 22.22.22.23
        oifname "eth1" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 counter snat to 22.22.22.23
        oifname "eth2" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 counter snat to 22.22.22.23
        oifname "eth3" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 counter snat to 22.22.22.23
        #
        # Rule 3 (NAT)
        #
        oifname "eth0" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 tcp dport 80 counter snat to 22.22.22.23
        oifname "eth1" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 tcp dport 80 counter snat to 22.22.22.23
        oifname "eth2" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 tcp dport 80 counter snat to 22.22.22.23
        oifname "eth3" ip saddr != 192.168.1.0/24 ip daddr 200.200.200.200 tcp dport 80 counter snat to 22.22.22.23
        #
        # Rule 4 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 counter snat to 22.22.22.22
        oifname "eth3" ip saddr 192.168.1.0/24 counter snat to 22.22.23.23
        oifname "eth2" ip saddr 192.168.1.0/24 counter snat to 192.168.2.1
        #
        # Rule 5 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 counter snat to 22.22.22.22
        oifname "eth3" ip saddr 192.168.1.0/24 counter snat to 22.22.23.23
        #
        # Rule 6 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 ip daddr != 192.168.2.0/24 counter snat to 22.22.22.22
        oifname "eth3" ip saddr 192.168.1.0/24 ip daddr != 192.168.2.0/24 counter snat to 22.22.23.23
        #
        # Rule 7 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 ip daddr != 192.168.2.0/24 tcp dport 80 counter snat to 22.22.22.22
        oifname "eth3" ip saddr 192.168.1.0/24 ip daddr != 192.168.2.0/24 tcp dport 80 counter snat to 22.22.23.23
        #
        # Rule 8 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } counter snat to 22.22.22.22
        oifname "eth3" ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } counter snat to 22.22.23.23
        oifname "eth2" ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } counter snat to 192.168.2.1
        #
        # Rule 9 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } counter snat to 22.22.22.22
        oifname "eth3" ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } counter snat to 22.22.23.23
        oifname "eth2" ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.0/24, 192.168.2.0/24 } counter snat to 192.168.2.1
        #
        # Rule 10 (NAT)
        #
        oifname "eth1" ip saddr != 192.168.2.0/24 counter snat to 22.22.22.22
        oifname "eth3" ip saddr != 192.168.2.0/24 counter snat to 22.22.23.23
        oifname "eth0" ip saddr != 192.168.2.0/24 counter snat to 192.168.1.1
    }
}

NFT_RULES
}

# nft parses and evaluates the whole batch before it installs anything, and
# refuses all of it over a single bad rule.  Asking first, while the running
# ruleset is still in place, is what keeps a rejected ruleset from turning
# into a firewall with no rules at all: the check touches nothing.
check_ruleset() {
    nft_ruleset | $NFT --check -f /dev/stdin
}

script_body() {
    nft_ruleset | $NFT -f /dev/stdin
}

ip_forward() {
    :

}

set_kernel_variables() {
    echo 30 > /proc/sys/net/ipv4/tcp_fin_timeout
    echo 1800 > /proc/sys/net/ipv4/tcp_keepalive_intvl
}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
    $NFT delete table inet fwf_mangle 2>/dev/null
    $NFT delete table ip fwf_mangle 2>/dev/null
    # Deleting a table that is not there fails, and most firewalls have no
    # mangle table, so without this the function would hand its caller the
    # exit code of a failed delete and "stop" would report failure.
    return 0
}

flush_legacy_iptables() {
    # Remove stale legacy (xtables) iptables rules left over from a
    # previous iptables-based policy. "nft flush ruleset" only clears
    # the nft backend, so on systems still using the legacy backend the
    # old iptables rules would otherwise survive and shadow the nft
    # rules. All filtering is delegated to nftables, so the built-in
    # policies are reset to ACCEPT and every chain is flushed/deleted.
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -P INPUT ACCEPT 2>/dev/null
        "$ipt" -P FORWARD ACCEPT 2>/dev/null
        "$ipt" -P OUTPUT ACCEPT 2>/dev/null
        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -F 2>/dev/null
            "$ipt" -t "$table" -X 2>/dev/null
        done
    done
    # Same as in flush_own_tables: a table the kernel does not offer makes
    # the last command fail, which must not become the caller's exit code.
    return 0
}

block_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
}

stop_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_nft
        configure_interfaces
        prolog_commands
        check_ruleset || {
            log "Ruleset rejected by nft, keeping the running firewall"
            run_epilog_and_exit 1
        }
        stop_action
        set_kernel_variables
        script_body || run_epilog_and_exit 1
        ip_forward
        epilog_commands
        log "Firewall script is done"
        ;;

    stop)
        check_nft
        stop_action
        RETVAL=$?
        ;;

    status)
        check_nft
        status_action
        RETVAL=$?
        ;;

    block)
        check_nft
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 stop
        $0 start
        RETVAL=$?
        ;;

    interfaces)
        configure_interfaces
        RETVAL=$?
        ;;

    test_interfaces)
        FWBDEBUG="echo"
        configure_interfaces
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload|interfaces|test_interfaces]"
        RETVAL=1
        ;;

esac

exit "$RETVAL"
