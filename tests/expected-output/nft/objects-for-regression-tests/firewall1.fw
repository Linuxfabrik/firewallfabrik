        #
        # Rule 18 (global)
        #
        # testing negation in the policy rule
        ip saddr != { 192.168.1.10, 192.168.1.20 } tcp dport { 80, 443 } ct state new limit rate 10/minute counter log level debug accept
        #
        # Rule 20 (global)
        #
        ip saddr != 192.168.2.0/24 ip daddr 192.168.1.0/24 counter log level debug drop
        #
