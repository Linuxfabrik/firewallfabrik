        #
        # # firewall-ipv6-1:Policy_ipv6:7: warning: Making rule stateless because it matches ICMPv6
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 8 (global)
        #
        # # firewall-ipv6-1:Policy_ipv6:8: warning: Making rule stateless because it matches ICMPv6
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 9 (global)
        #
        tcp dport 993 ct state new counter accept
        # # firewall-ipv6-1:Policy_ipv6:9: warning: Making rule stateless because it matches ICMPv6
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 10 (global)
        #
        tcp dport { 3268, 3269, 445, 42, 53, 88, 389, 636, 135, 139 } ct state new counter accept
        udp dport { 53, 88, 138, 137 } ct state new counter accept
        # # firewall-ipv6-1:Policy_ipv6:10: warning: Making rule stateless because it matches ICMPv6
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 11 (global)
        #
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 12 (global)
        #
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 13 (global)
        #
        meta l4proto ipv6-icmp counter accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        #
        # Rule 10 (global)
        #
        ip saddr { 61.150.47.112, 192.168.1.0 } ct state new counter log prefix "RULE 10 -- ACCEPT " level info accept
        #
        # Rule 13 (global)
        #
        meta l4proto icmp ct state new counter accept
        #
        # Rule 15 (global)
        #
        icmp type echo-request icmp code 0 ct state new counter accept
        #
        # Rule 17 (global)
        #
        icmp type echo-request icmp code 0 ct state new counter accept
        #
        # Rule 18 (global)
        #
        # INPUT, OUTPUT, FORWARD
        ip saddr 1.1.1.0/24 ct state new counter accept
        #
        # Rule 19 (global)
        #
        # INPUT, OUTPUT, FORWARD
        ip daddr 1.1.1.0/24 ct state new counter accept
        #
        # Rule Policy_ipv6 3 (global)
        #
        # INPUT, OUTPUT, FORWARD
        ip6 saddr fe80::/64 ct state new counter accept
        #
        # Rule Policy_ipv6 4 (global)
        #
        # INPUT, OUTPUT, FORWARD
        ip6 daddr fe80::/64 ct state new counter accept
        #
        # Rule Policy_ipv6 8 (global)
        #
        # # firewall-ipv6-1:Policy_ipv6:8: warning: Making rule stateless because it matches ICMPv6
        meta l4proto ipv6-icmp counter accept
        #
        # Rule Policy_ipv6 13 (global)
        #
        meta l4proto ipv6-icmp counter accept
    }

    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 counter accept
        #
        # Rule 11 (global)
