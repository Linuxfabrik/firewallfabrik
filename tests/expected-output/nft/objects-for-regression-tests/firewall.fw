        # # Rule 48 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr { 192.168.1.11, 192.168.1.12, 192.168.1.13, 192.168.1.14, 192.168.1.15 } tcp dport { 113, 80, 443, 143, 25, 22, 540 } ct state new counter accept
        #
        # Rule 50 (global)
        #
        # another test case for multiport: this rule
        # has 16 TCP services and should be split onto
        # two rules. If both rules use "-m multiport", then
        # rule with a single service should use "--dports".
        # It may be acceptable to not use multiport
        # in the rule with a single service at all.
        ip saddr 192.168.1.0/24 ip daddr 192.168.1.11-192.168.1.15 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } ct state new limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        ip saddr 192.168.1.0/24 ip daddr 192.168.1.11-192.168.1.15 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } ct state new counter accept
        #
        # Rule 53 (global)
        #
        # Automatically generated 'masquerading' rule
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 54 (global)
        #
        # similar to a standard 'masquerading'
        # rule, but not so permissive as it does
        # not allow access to the firewall
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 55 (global)
        #
        ip saddr 192.168.1.0/24 ip daddr != 33.33.33.0/24 ct state new counter accept
        #
        # Rule 56 (global)
        #
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr { 192.168.1.0/24, 192.168.2.0/24 } tcp dport { 113, 10000-11000 } ct state new counter accept
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr { 192.168.1.0/24, 192.168.2.0/24 } udp dport { 53, 161 } ct state new counter accept
        #
        # Rule 57 (global)
        #
        # Automatically generated 'catch all' rule
        limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        tcp flags != syn / syn,rst,ack ct state new counter drop
        #
        # Rule 3 (eth1)
        #
        oifname "eth1" ip daddr { 192.168.1.1, 222.222.222.222 } udp dport 53 ct state new counter accept
        #
        # Rule 4 (eth1)
        #
        # rule in FORWARD chain with
        # -o eth1 and dest address of the firewall
        # is pretty much impossible
        oifname "eth1" ip daddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 5 (eth1)
        #
        oifname "eth1" ip daddr { 222.222.222.222, 192.168.1.10 } udp dport 53 ct state new counter accept
        #
        # Rule 6 (eth1)
        #
        oifname "eth1" ip daddr { 222.222.222.222, 192.168.1.10 } udp dport 53 ct state new counter accept
        #
        # Rule 7 (eth1)
        #
        oifname "eth1" udp dport 53 ct state new counter accept
        #
        # Rule 8 (eth1)
        #
        # keep FORWARD chain
        # because it is needed for anti-spoofing rules
        oifname "eth1" ip saddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 9 (eth1)
        #
        oifname "eth1" ip saddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 10 (eth0)
        #
        oifname "eth0" ip saddr 192.168.1.0/24 ip daddr { 192.168.1.1, 222.222.222.222 } udp dport 53 ct state new counter accept
        #
        # Rule 16 (global)
        #
        # OUTPUT
        ip daddr 1.1.1.1 counter accept
        #
        # Rule 18 (global)
        #
        # OUTPUT + FORWARD
        ip daddr 1.1.1.1 counter accept
        #
        # Rule 20 (global)
        #
        # OUTPUT + FORWARD
        ip daddr 1.1.1.1 counter accept
        #
        # Rule 22 (global)
        #
        meta l4proto icmp limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        meta l4proto icmp counter drop
        tcp flags & (urg | ack | psh | rst | syn | fin) == 0x0 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags & (urg | ack | psh | rst | syn | fin) == 0x0 counter drop
        tcp flags syn / syn,rst,ack limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags syn / syn,rst,ack counter drop
        tcp flags ack,rst,syn,fin / urg,ack,psh,rst,syn,fin limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags ack,rst,syn,fin / urg,ack,psh,rst,syn,fin counter drop
        #
        # Rule 23 (global)
        #
        ip option rr exists counter drop
        ip option lsrr exists ip option ssrr exists counter drop
        #
        # Rule 24 (global)
        #
        ip hdrlength > 5 counter drop
        #
        # Rule 28 (global)
        #
        # both src and dst have multiple interfaces
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } ct state new counter accept
        ip daddr { 33.33.33.33, 172.16.1.1, 192.168.100.1 } ct state new counter accept
        #
        # Rule 44 (global)
        #
        ip daddr 192.168.1.10 tcp sport 1024-65535 tcp dport 80 ct state new counter accept
        #
        # Rule 45 (global)
        #
        # Rule #20 test: from Rock
        ip daddr 192.168.1.10 tcp dport { 53, 3128 } ct state new counter accept
        ip daddr 192.168.1.10 tcp sport 53 ct state new counter accept
        ip daddr 192.168.1.10 tcp sport 1024-65535 tcp dport 80 ct state new counter accept
        #
        # Rule 46 (global)
        #
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type destination-unreachable ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type echo-reply icmp code 0 ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type time-exceeded icmp code 0 ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type time-exceeded icmp code 1 ct state new counter accept
        #
        # Rule 47 (global)
        #
        # # Rule 47 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.11-192.168.1.15 tcp dport { 113, 80, 443, 143, 25, 22, 540 } ct state new counter accept
        #
        # Rule 48 (global)
        #
        # # Rule 48 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr { 192.168.1.11, 192.168.1.12, 192.168.1.13, 192.168.1.14, 192.168.1.15 } tcp dport { 113, 80, 443, 143, 25, 22, 540 } ct state new counter accept
        #
        # Rule 50 (global)
        #
        # another test case for multiport: this rule
        # has 16 TCP services and should be split onto
        # two rules. If both rules use "-m multiport", then
        # rule with a single service should use "--dports".
        # It may be acceptable to not use multiport
        # in the rule with a single service at all.
        ip saddr 192.168.1.0/24 ip daddr 192.168.1.11-192.168.1.15 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } ct state new limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        ip saddr 192.168.1.0/24 ip daddr 192.168.1.11-192.168.1.15 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } ct state new counter accept
        #
        # Rule 51 (global)
        #
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } ct state new limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } ct state new counter accept
        #
        # Rule 52 (global)
        #
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } udp dport 161 ct state new counter accept
        ip daddr 200.200.200.200 udp dport 161 ct state new counter accept
        #
        # Rule 53 (global)
        #
        # Automatically generated 'masquerading' rule
        ct state new counter accept
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 54 (global)
        #
        # similar to a standard 'masquerading'
        # rule, but not so permissive as it does
        # not allow access to the firewall
        ip saddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 55 (global)
        #
        ip saddr 192.168.1.0/24 ip daddr != 33.33.33.0/24 ct state new counter accept
        #
        # Rule 56 (global)
        #
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr { 192.168.1.0/24, 192.168.2.0/24 } tcp dport { 113, 10000-11000 } ct state new counter accept
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr { 192.168.1.0/24, 192.168.2.0/24 } udp dport { 53, 161 } ct state new counter accept
        #
        # Rule 57 (global)
        #
        # Automatically generated 'catch all' rule
        limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        counter drop
    }
}

table ip fwf_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat;
        #
        # Rule 4 (NAT)
        #
        ip saddr 192.168.1.0/24 ip daddr 192.168.1.20 tcp dport 80 counter dnat to :3128
        #
        # Rule 6 (NAT)
        #
        ip daddr 192.168.1.1 tcp dport 25 counter dnat to 192.168.1.10:25
        ip daddr 222.222.222.222 tcp dport 25 counter dnat to 192.168.1.10:25
        #
        # Rule 7 (NAT)
        #
        ip daddr 192.168.1.1 icmp type echo-request icmp code 0 counter dnat to 192.168.1.10
        ip daddr 222.222.222.222 icmp type echo-request icmp code 0 counter dnat to 192.168.1.10
        #
        # Rule 8 (NAT)
        #
        ip daddr 192.168.1.1 icmp type echo-request icmp code 0 counter dnat to 192.168.1.10
        ip daddr 222.222.222.222 icmp type echo-request icmp code 0 counter dnat to 192.168.1.10
        #
        # Rule 9 (NAT)
        #
        ip daddr 192.168.1.1 tcp sport 1000-1010 counter dnat to 192.168.1.10
        ip daddr 222.222.222.222 tcp sport 1000-1010 counter dnat to 192.168.1.10
        #
        # Rule 12 (NAT)
        #
        ether saddr 00:10:4b:de:e9:70 ip daddr 222.222.222.40 tcp dport 25 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:70 ip daddr 222.222.222.41 tcp dport 25 counter dnat to 192.168.1.10
        #
        # Rule 13 (NAT)
        #
        ip saddr 192.168.1.15 ip daddr 222.222.222.40 tcp dport 25 counter dnat to 192.168.1.10
        ip saddr 192.168.1.15 ip daddr 222.222.222.41 tcp dport 25 counter dnat to 192.168.1.10
        ether saddr aa:bb:cc:dd:ee:ff ip daddr 222.222.222.40 tcp dport 25 counter dnat to 192.168.1.10
        ether saddr aa:bb:cc:dd:ee:ff ip daddr 222.222.222.41 tcp dport 25 counter dnat to 192.168.1.10
        #
        # Rule 14 (NAT)
        #
        # hsould match mac and ip addresses
        ip saddr 192.168.1.10 ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ip saddr 192.168.1.10 ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:6f ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:6f ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:70 ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:70 ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:71 ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:71 ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        #
        # Rule 15 (NAT)
        #
        # ensure generated rules match different mac addresses
        ip saddr 192.168.1.10 ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ip saddr 192.168.1.10 ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        ip saddr 192.168.1.15 ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ip saddr 192.168.1.15 ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:6f ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr 00:10:4b:de:e9:6f ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr aa:bb:cc:dd:ee:ff ip daddr 192.168.1.1 tcp dport 80 counter dnat to 192.168.1.10
        ether saddr aa:bb:cc:dd:ee:ff ip daddr 222.222.222.222 tcp dport 80 counter dnat to 192.168.1.10
        #
        # Rule 17 (NAT)
        #
        ip daddr 192.168.1.1 tcp sport 1024-65535 tcp dport 80 counter dnat to 192.168.1.10:80
        ip daddr 222.222.222.222 tcp sport 1024-65535 tcp dport 80 counter dnat to 192.168.1.10:80
        #
        # Rule 18 (NAT)
        #
        ip daddr 192.168.1.1 tcp sport 53 counter dnat to 192.168.1.10
        ip daddr 222.222.222.222 tcp sport 53 counter dnat to 192.168.1.10
        #
        # Rule 19 (NAT)
        #
        ip daddr 192.168.1.1 tcp dport 4000-4010 counter dnat to 192.168.1.10:4000-4010
        ip daddr 222.222.222.222 tcp dport 4000-4010 counter dnat to 192.168.1.10:4000-4010
        #
        # Rule 21 (NAT)
        #
        ip saddr 192.168.1.10 tcp dport 3128 counter dnat to :80
        #
        # Rule 23 (NAT)
        #
        # should use multiport
        # and account for
        # no more than 15 ports
        # per rule
        ip daddr 222.222.222.222 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 143, 993, 6667, 6667, 543, 544, 389, 98, 3306, 2049, 119, 110, 5432, 515, 26000, 512, 513, 514, 4321, 25, 465, 1080, 3128, 22, 111, 23, 10000-11000, 540, 7100 } counter dnat to 192.168.1.10
        #
        # Rule 24 (NAT)
        #
        # should use multiport
        # and account for
        # no more than 15 ports
        # per rule
        ip daddr 222.222.222.222 tcp dport != { 113, 13, 53, 2105, 21, 70, 80, 443, 143, 993, 6667, 6667, 543, 544, 389, 98, 3306, 2049, 119, 110, 5432, 515, 26000, 512, 513, 514, 4321, 25, 465, 1080, 3128, 22, 111, 23, 10000-11000, 540, 7100 } counter dnat to 192.168.1.10
    }

    chain output {
        type nat hook output priority dstnat;
        #
        # Rule 22 (NAT)
        #
        tcp dport 3128 counter dnat to :80
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        #
        # Rule 0 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 counter snat to 222.222.222.222
        #
        # Rule 1 (NAT)
        #
        ip saddr 192.168.1.0/24 counter snat prefix to 222.222.222.0/24
        #
        # Rule 2 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.10-192.168.1.100 counter snat to 222.222.222.10-222.222.222.100
        oifname "eth0" ip saddr 192.168.1.10-192.168.1.100 counter snat to 222.222.222.10-222.222.222.100
        #
        # Rule 4 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 tcp dport 3128 counter snat to 192.168.1.1
        oifname "eth0" ip saddr 192.168.1.0/24 tcp dport 3128 counter snat to 192.168.1.1
        #
        # Rule 5 (NAT)
        #
        oifname "eth1" ip daddr 22.22.22.23 tcp dport { 3128, 4000-4010 } counter snat to 192.168.1.10
        oifname "eth0" ip daddr 22.22.22.23 tcp dport { 3128, 4000-4010 } counter snat to 192.168.1.10
        #
        # Rule 10 (NAT)
        #
        oifname "eth0" ip saddr 192.168.1.10 tcp sport 1000-1010 counter snat to 192.168.1.1:1000-1010
        oifname "eth1" ip saddr 192.168.1.10 tcp sport 1000-1010 counter snat to 222.222.222.222:1000-1010
        #
        # Rule 11 (NAT)
        #
        oifname "eth1" ip saddr 192.168.1.10 tcp dport 25 counter snat to 222.222.222.222
        #
        # Rule 16 (NAT)
        #
        # should match mac and ip addresses
        oifname "eth1" ip saddr 192.168.1.10 ip daddr != { 61.150.47.112, 223.223.223.223 } tcp dport 80 counter snat to 222.222.222.222
        #
        # Rule 20 (NAT)
        #
        oifname "eth0" ip saddr 192.168.1.10 tcp dport 4000-4010 counter snat to 192.168.1.1
        oifname "eth1" ip saddr 192.168.1.10 tcp dport 4000-4010 counter snat to 222.222.222.222
    }
}

NFT_RULES
}

# nft parses and evaluates the whole batch before it installs anything, and
# refuses all of it over a single bad rule.  Asking first, while the running
# ruleset is still in place, is what keeps a rejected ruleset from turning
# into a firewall with no rules at all: the check touches nothing.
check_ruleset() {
    nft_ruleset | $NFT --check -f /dev/stdin
}

script_body() {
    nft_ruleset | $NFT -f /dev/stdin
}

ip_forward() {
    :
    echo 1 > /proc/sys/net/ipv4/ip_forward
}

set_kernel_variables() {
    echo 30 > /proc/sys/net/ipv4/tcp_fin_timeout
    echo 1800 > /proc/sys/net/ipv4/tcp_keepalive_intvl
}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
    $NFT delete table inet fwf_mangle 2>/dev/null
    $NFT delete table ip fwf_mangle 2>/dev/null
    # Deleting a table that is not there fails, and most firewalls have no
    # mangle table, so without this the function would hand its caller the
    # exit code of a failed delete and "stop" would report failure.
    return 0
}

flush_legacy_iptables() {
    # Remove stale legacy (xtables) iptables rules left over from a
    # previous iptables-based policy. "nft flush ruleset" only clears
    # the nft backend, so on systems still using the legacy backend the
    # old iptables rules would otherwise survive and shadow the nft
    # rules. All filtering is delegated to nftables, so the built-in
    # policies are reset to ACCEPT and every chain is flushed/deleted.
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -P INPUT ACCEPT 2>/dev/null
        "$ipt" -P FORWARD ACCEPT 2>/dev/null
        "$ipt" -P OUTPUT ACCEPT 2>/dev/null
        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -F 2>/dev/null
            "$ipt" -t "$table" -X 2>/dev/null
        done
    done
    # Same as in flush_own_tables: a table the kernel does not offer makes
    # the last command fail, which must not become the caller's exit code.
    return 0
}

block_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
    # backup ssh access
    $NFT add rule inet fwf_filter input tcp dport 22 ip saddr 192.168.1.100 ct state new,established accept
    $NFT add rule inet fwf_filter output tcp sport 22 ip daddr 192.168.1.100 ct state established accept
}

stop_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_nft
        prolog_commands
        configure_interfaces
        verify_interfaces
        check_ruleset || {
            log "Ruleset rejected by nft, keeping the running firewall"
            run_epilog_and_exit 1
        }
        stop_action
        set_kernel_variables
        script_body || run_epilog_and_exit 1
        ip_forward
        RETVAL=$?
        epilog_commands
        log "Firewall script is done"
        ;;

    stop)
        check_nft
        stop_action
        RETVAL=$?
        ;;

    status)
        check_nft
        status_action
        RETVAL=$?
        ;;

    block)
        check_nft
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 stop
        $0 start
        RETVAL=$?
        ;;

    interfaces)
        configure_interfaces
        RETVAL=$?
        ;;

    test_interfaces)
        FWBDEBUG="echo"
        configure_interfaces
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload|interfaces|test_interfaces]"
        ;;

esac

exit "$RETVAL"
