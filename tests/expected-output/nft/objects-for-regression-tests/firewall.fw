nft_ruleset() {
    cat <<'NFT_RULES'
table ip fwf_filter {}
delete table ip fwf_filter
table ip fwf_nat {}
delete table ip fwf_nat

table ip fwf_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        tcp flags != syn / syn,rst,ack ct state new counter drop
        #
        # Rule 0 (eth1)
        #
        # Automatically generated rule blocking short fragments
        iifname "eth1" ip frag-off & 0x1fff != 0 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip frag-off & 0x1fff != 0 counter drop
        #
        # Rule 1 (eth1)
        #
        # тестовый комментарий по-русски. Проверяем конвертацию из/в Utf8
        iifname "eth1" ip frag-off & 0x1fff != 0 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip frag-off & 0x1fff != 0 counter drop
        #
        # Rule 2 (eth1)
        #
        # Automatically generated anti-spoofing rule
        iifname "eth1" ip saddr { 192.168.1.1, 222.222.222.222 } limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip saddr { 192.168.1.1, 222.222.222.222 } counter drop
        iifname "eth1" ip saddr 192.168.1.0/24 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip saddr 192.168.1.0/24 counter drop
        #
        # Rule 3 (eth1)
        #
        iifname "eth1" udp dport 53 ct state new counter accept
        #
        # Rule 4 (eth1)
        #
        # rule in FORWARD chain with
        # -o eth1 and dest address of the firewall
        # is pretty much impossible
        iifname "eth1" ip daddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 5 (eth1)
        #
        iifname "eth1" ip daddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 6 (eth1)
        #
        iifname "eth1" ip daddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 7 (eth1)
        #
        iifname "eth1" ip saddr { 192.168.1.1, 222.222.222.222 } udp dport 53 ct state new counter accept
        #
        # Rule 8 (eth1)
        #
        # keep FORWARD chain
        # because it is needed for anti-spoofing rules
        iifname "eth1" ip saddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 9 (eth1)
        #
        iifname "eth1" ip saddr { 222.222.222.222, 192.168.1.10 } udp dport 53 ct state new counter accept
        #
        # Rule 10 (eth0)
        #
        iifname "eth0" ip saddr 192.168.1.0/24 udp dport 53 ct state new counter accept
        #
        # Rule 12 (eth0)
        #
        iifname "eth0" tcp dport 80 ct state new counter accept
        #
        # Rule 13 (eth0,eth1)
        #
        # reject using connlimit
        iifname "eth0" counter drop
        iifname "eth1" counter drop
        #
        # Rule 14 (eth0,eth1)
        #
        # reject using connlimit
        iifname "eth0" counter drop
        iifname "eth1" counter drop
        #
        # Rule 15 (eth0,eth1)
        #
        iifname "eth0" ct state new counter accept
        iifname "eth1" ct state new counter accept
        #
        # Rule 17 (global)
        #
        # INTPUT with "-i +"
        # "-i +" is redundant if chain is INPUT,
        # optimization removes it
        ip saddr 1.1.1.1 counter accept
        #
        # Rule 19 (global)
        #
        # INPUT + FORWARD
        ip saddr 1.1.1.1 counter accept
        #
        # Rule 21 (global)
        #
        # INPUT + FORWARD
        ip saddr 1.1.1.1 counter accept
        #
        # Rule 22 (global)
        #
        meta l4proto icmp limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        meta l4proto icmp counter drop
        tcp flags & (urg | ack | psh | rst | syn | fin) == 0x0 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags & (urg | ack | psh | rst | syn | fin) == 0x0 counter drop
        tcp flags syn / syn,rst,ack limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags syn / syn,rst,ack counter drop
        tcp flags ack,rst,syn,fin / urg,ack,psh,rst,syn,fin limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags ack,rst,syn,fin / urg,ack,psh,rst,syn,fin counter drop
        #
        # Rule 23 (global)
        #
        # # Rule 23 (global): IP service matching the "timestamp" IP option is not supported by nftables, which can only match the lsrr, ssrr, rr and router-alert options
        ip option rr exists counter drop
        # # Rule 23 (global): IP service matching the "timestamp" IP option is not supported by nftables, which can only match the lsrr, ssrr, rr and router-alert options
        ip option lsrr exists ip option ssrr exists counter drop
        #
        # Rule 24 (global)
        #
        ip hdrlength > 5 counter drop
        #
        # Rule 28 (global)
        #
        # both src and dst have multiple interfaces
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } ct state new counter accept
        ip saddr { 33.33.33.33, 172.16.1.1, 192.168.100.1 } ct state new counter accept
        #
        # Rule 30 (global)
        #
        ip saddr 192.168.1.10 ct state new counter accept
        #
        # Rule 32 (global)
        #
        ether saddr 00:10:4b:de:e9:70 ct state new counter accept
        #
        # Rule 34 (global)
        #
        ether saddr aa:bb:cc:dd:ee:ff ip saddr 192.168.1.15 ct state new counter accept
        #
        # Rule 35 (global)
        #
        ether saddr aa:bb:cc:dd:ee:ff ct state new counter accept
        #
        # Rule 40 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 tcp dport 80 ct state new counter accept
        ether saddr { 00:10:4b:de:e9:70, 00:10:4b:de:e9:71 } tcp dport 80 ct state new counter accept
        #
        # Rule 46 (global)
        #
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type destination-unreachable ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type echo-reply icmp code 0 ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type time-exceeded icmp code 0 ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type time-exceeded icmp code 1 ct state new counter accept
        #
        # Rule 49 (global)
        #
        # group "special combined srv"
        # has couple of UDP services,
        # plus "ALL UDP" service, which has
        # empty ports specs. This is special
        # case for multiport.
        ip saddr 192.168.1.0/24 meta l4proto udp ct state new counter accept
        ip saddr 192.168.1.0/24 udp dport { 68, 67 } ct state new counter accept
        #
        # Rule 51 (global)
        #
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } ct state new limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } ct state new counter accept
        #
        # Rule 52 (global)
        #
        ip saddr { 192.168.1.1, 222.222.222.222 } ip daddr { 192.168.1.1, 222.222.222.222 } udp dport 161 ct state new counter accept
        #
        # Rule 53 (global)
        #
        # Automatically generated 'masquerading' rule
        ip saddr { 192.168.1.1, 222.222.222.222, 192.168.1.0/24 } ct state new counter accept
        #
        # Rule 54 (global)
        #
        # similar to a standard 'masquerading'
        # rule, but not so permissive as it does
        # not allow access to the firewall
        ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.1, 222.222.222.222 } ct state new counter accept
        #
        # Rule 55 (global)
        #
        ip saddr 192.168.1.0/24 ip daddr != { 192.168.1.1, 222.222.222.222 } ct state new counter accept
        #
        # Rule 56 (global)
        #
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr { 192.168.1.0/24, 192.168.2.0/24 } tcp dport { 113, 10000-11000 } ct state new counter accept
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr { 192.168.1.0/24, 192.168.2.0/24 } udp dport { 53, 161 } ct state new counter accept
        #
        # Rule 57 (global)
        #
        # Automatically generated 'catch all' rule
        limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related counter accept
        ct state invalid counter log prefix "INVALID " level debug drop
        tcp flags != syn / syn,rst,ack ct state new counter drop
        #
        # Rule 0 (eth1)
        #
        # Automatically generated rule blocking short fragments
        iifname "eth1" ip frag-off & 0x1fff != 0 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip frag-off & 0x1fff != 0 counter drop
        #
        # Rule 2 (eth1)
        #
        # Automatically generated anti-spoofing rule
        iifname "eth1" ip saddr { 192.168.1.1, 222.222.222.222 } limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip saddr { 192.168.1.1, 222.222.222.222 } counter drop
        iifname "eth1" ip saddr 192.168.1.0/24 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth1" ip saddr 192.168.1.0/24 counter drop
        #
        # Rule 5 (eth1)
        #
        iifname "eth1" ip daddr 192.168.1.10 udp dport 53 ct state new counter accept
        oifname "eth1" ip daddr 192.168.1.10 udp dport 53 ct state new counter accept
        #
        # Rule 6 (eth1)
        #
        iifname "eth1" ip daddr 192.168.1.10 udp dport 53 ct state new counter accept
        oifname "eth1" ip daddr 192.168.1.10 udp dport 53 ct state new counter accept
        #
        # Rule 7 (eth1)
        #
        iifname "eth1" ip saddr { 192.168.1.1, 222.222.222.222 } udp dport 53 ct state new counter accept
        #
        # Rule 8 (eth1)
        #
        # keep FORWARD chain
        # because it is needed for anti-spoofing rules
        iifname "eth1" ip saddr 222.222.222.222 udp dport 53 ct state new counter accept
        #
        # Rule 9 (eth1)
        #
        iifname "eth1" ip saddr { 222.222.222.222, 192.168.1.10 } udp dport 53 ct state new counter accept
        oifname "eth1" ip saddr 192.168.1.10 udp dport 53 ct state new counter accept
        #
        # Rule 11 (eth0)
        #
        # code should go into INPUT chain with
        # address in destination for comparison
        iifname "eth0" ip daddr 192.168.1.255 udp dport 53 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        iifname "eth0" ip daddr 192.168.1.255 udp dport 53 counter drop
        #
        # Rule 12 (eth0)
        #
        iifname "eth0" tcp dport 80 ct state new counter accept
        #
        # Rule 18 (global)
        #
        # OUTPUT + FORWARD
        ip daddr 1.1.1.1 counter accept
        #
        # Rule 19 (global)
        #
        # INPUT + FORWARD
        ip saddr 1.1.1.1 counter accept
        #
        # Rule 20 (global)
        #
        # OUTPUT + FORWARD
        ip daddr 1.1.1.1 counter accept
        #
        # Rule 21 (global)
        #
        # INPUT + FORWARD
        ip saddr 1.1.1.1 counter accept
        #
        # Rule 22 (global)
        #
        meta l4proto icmp limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        meta l4proto icmp counter drop
        tcp flags & (urg | ack | psh | rst | syn | fin) == 0x0 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags & (urg | ack | psh | rst | syn | fin) == 0x0 counter drop
        tcp flags syn / syn,rst,ack limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags syn / syn,rst,ack counter drop
        tcp flags ack,rst,syn,fin / urg,ack,psh,rst,syn,fin limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        tcp flags ack,rst,syn,fin / urg,ack,psh,rst,syn,fin counter drop
        #
        # Rule 23 (global)
        #
        # # Rule 23 (global): IP service matching the "timestamp" IP option is not supported by nftables, which can only match the lsrr, ssrr, rr and router-alert options
        ip option rr exists counter drop
        # # Rule 23 (global): IP service matching the "timestamp" IP option is not supported by nftables, which can only match the lsrr, ssrr, rr and router-alert options
        ip option lsrr exists ip option ssrr exists counter drop
        #
        # Rule 24 (global)
        #
        ip hdrlength > 5 counter drop
        #
        # Rule 28 (global)
        #
        # both src and dst have multiple interfaces
        ip saddr { 33.33.33.33, 172.16.1.1, 192.168.100.1 } ip daddr { 33.33.33.33, 172.16.1.1, 192.168.100.1 } ct state new counter accept
        #
        # Rule 29 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 ip daddr 192.168.1.10 ct state new counter accept
        #
        # Rule 31 (global)
        #
        ether saddr 00:10:4b:de:e9:70 ip daddr 192.168.1.10 ct state new counter accept
        #
        # Rule 33 (global)
        #
        ether saddr 00:10:4b:de:e9:70 ip daddr 200.200.200.200 ct state new counter accept
        #
        # Rule 36 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 ip daddr 192.168.1.10 ct state new counter accept
        ether saddr { 00:10:4b:de:e9:70, 00:10:4b:de:e9:71 } ip daddr 192.168.1.10 ct state new counter accept
        #
        # Rule 37 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 ip daddr 192.168.1.10 ct state new counter accept
        ether saddr { 00:10:4b:de:e9:70, 00:10:4b:de:e9:71 } ip daddr 192.168.1.10 ct state new counter accept
        ip saddr 192.168.1.20 ip daddr 192.168.1.10 ct state new counter accept
        #
        # Rule 38 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 ip daddr 192.168.1.10 tcp sport 53 ct state new counter accept
        ether saddr { 00:10:4b:de:e9:70, 00:10:4b:de:e9:71 } ip daddr 192.168.1.10 tcp sport 53 ct state new counter accept
        #
        # Rule 39 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 ip daddr 192.168.1.10 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 143, 993, 6667, 6667, 543, 544, 389, 98, 3306, 2049, 119, 110, 5432, 515, 26000, 512, 513, 514, 4321, 25, 465, 1080, 3128, 22, 111, 23, 10000-11000, 540, 7100 } ct state new counter accept
        ether saddr { 00:10:4b:de:e9:70, 00:10:4b:de:e9:71 } ip daddr 192.168.1.10 tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 143, 993, 6667, 6667, 543, 544, 389, 98, 3306, 2049, 119, 110, 5432, 515, 26000, 512, 513, 514, 4321, 25, 465, 1080, 3128, 22, 111, 23, 10000-11000, 540, 7100 } ct state new counter accept
        #
        # Rule 40 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.10 tcp dport 80 ct state new counter accept
        ether saddr { 00:10:4b:de:e9:70, 00:10:4b:de:e9:71 } tcp dport 80 ct state new counter accept
        #
        # Rule 41 (global)
        #
        ether saddr 00:10:4b:de:e9:6f ip saddr 192.168.1.1 ip daddr 192.168.1.10 ct state new counter accept
        #
        # Rule 42 (global)
        #
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 0-86340 meta day { "Saturday" } limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        # # firewall:Policy:42: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 0-86340 meta day { "Saturday" } counter accept
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 0-86340 meta day { "Sunday" } limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        # # firewall:Policy:42: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 0-86340 meta day { "Sunday" } counter accept
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 64800-86340 limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        # # firewall:Policy:42: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 64800-86340 counter accept
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 3660-7320 meta day { "Sunday", "Monday" } limit rate 5/second counter log prefix "CUSTOM LOGGING" level debug
        # # firewall:Policy:42: warning: nftables always matches the weekday in the kernel timezone; turn on "use kernel timezone" so iptables agrees
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr 192.168.1.10 ct state new meta hour 3660-7320 meta day { "Sunday", "Monday" } counter accept
        #
        # Rule 43 (global)
        #
        ip saddr { 211.11.11.11, 211.22.22.22 } ip daddr { 192.168.1.10, 192.168.1.20 } tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 143, 993, 6667, 6667, 543, 544, 389, 98, 3306, 2049, 119, 110, 5432, 515, 26000, 512, 513, 514, 4321, 25, 465, 1080, 3128, 22, 111, 23, 10000-11000, 540, 7100 } ct state new counter accept
        #
        # Rule 44 (global)
        #
        ip daddr 192.168.1.10 tcp sport 1024-65535 tcp dport 80 ct state new counter accept
        #
        # Rule 45 (global)
        #
        # Rule #20 test: from Rock
        ip daddr 192.168.1.10 tcp dport { 53, 3128 } ct state new counter accept
        ip daddr 192.168.1.10 tcp sport 53 ct state new counter accept
        ip daddr 192.168.1.10 tcp sport 1024-65535 tcp dport 80 ct state new counter accept
        #
        # Rule 46 (global)
        #
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type destination-unreachable ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type echo-reply icmp code 0 ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type time-exceeded icmp code 0 ct state new counter accept
        # # Rule 46 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.0/24 icmp type time-exceeded icmp code 1 ct state new counter accept
        #
        # Rule 47 (global)
        #
        # # Rule 47 (global): Custom service 'talk' is not configured for 'nftables'
        ip daddr 192.168.1.11-192.168.1.15 tcp dport { 113, 80, 443, 143, 25, 22, 540 } ct state new counter accept
        #
        # Rule 48 (global)
