#!/bin/sh
#
#  This file is managed by FirewallFabrik - do not edit
#
#  FirewallFabrik fwf-nft VERSION
#
#  Generated TIMESTAMP
#
# files: * firewall5.fw /etc/fwf.sh
#
#  testing firewall_is_part_of_any_and_networks. Also testing SNAT and DNAT rules when external interface has dynamic address.

#  dynamic interface ppp0 has an address object attached to it (interface used to be static and had an address, then got converted to dynamic but address object is still there). Compiler should ignore this address object and issue a warning.

#  All "configure interfaces" options are off, testing shell functions for this case.
#

FWBDEBUG=""
# Every branch of the case below is expected to leave an exit code here, and
# the one that prints the usage says 1.  Without the initialisation the
# script ends in `exit ""`, which the shell answers with "numeric argument
# required" and an exit code of its own choosing.  The iptables skeleton has
# had both lines since fwbuilder wrote it.
RETVAL=0

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="/usr/sbin/nft"
IP="ip"
LOGGER="logger"

log() {
    echo "$1"
    command -v "$LOGGER" >/dev/null 2>&1 && $LOGGER -p info "$1"
}

getInterfaceVarName() {
    echo "$1" | sed 's/\./_/'
}

getaddr_internal() {
    dev=$1
    name=$2
    af=$3
    L=$("$IP" "$af" addr show dev "$dev" | sed -n '/inet/{s!.*inet6* !!;s!/.*!!p}' | sed 's/peer.*//')
    test -z "$L" && {
        eval "$name=''"
        return
    }
    eval "${name}_list=\"$L\""
}

getnet_internal() {
    dev=$1
    name=$2
    af=$3
    L=$("$IP" route list proto kernel | grep "$dev" | grep -v default | sed 's! .*$!!')
    test -z "$L" && {
        eval "$name=''"
        return
    }
    eval "${name}_list=\"$L\""
}

getaddr() {
    getaddr_internal "$1" "$2" "-4"
}

getaddr6() {
    getaddr_internal "$1" "$2" "-6"
}

getnet() {
    getnet_internal "$1" "$2" "-4"
}

getnet6() {
    getnet_internal "$1" "$2" "-6"
}

# function getinterfaces is used to process wildcard interfaces
getinterfaces() {
    NAME=$1
    "$IP" link show | grep ": $NAME" | while read -r L; do
        OIFS=$IFS
        IFS=" :"
        # shellcheck disable=SC2086
        set -- $L
        IFS=$OIFS
        echo "$2"
    done
}

diff_intf() {
    func=$1
    list1=$2
    list2=$3
    cmd=$4
    for intf in $list1
    do
        echo "$list2" | grep -q "$intf" || {
        # $intf is absent in list 2
            "$func" "$intf" "$cmd"
        }
    done
}

P2P_INTERFACE_WARNING=""

missing_address() {
    address=$1
    cmd=$2

    oldIFS=$IFS
    IFS="@"
    # shellcheck disable=SC2086
    set -- $address
    addr=$1
    interface=$2
    IFS=$oldIFS

    "$IP" addr show dev "$interface" | grep -q POINTOPOINT && {
        test -z "$P2P_INTERFACE_WARNING" && echo "Warning: Can not update address of interface $interface. fwbuilder can not manage addresses of point-to-point interfaces yet"
        P2P_INTERFACE_WARNING="yes"
        return
    }

    test "$cmd" = "add" && {
      echo "# Adding ip address: $interface $addr"
      if echo "$addr" | grep -q ':'; then
          $FWBDEBUG "$IP" addr "$cmd" "$addr" dev "$interface"
      else
          $FWBDEBUG "$IP" addr "$cmd" "$addr" broadcast + dev "$interface"
      fi
    }

    test "$cmd" = "del" && {
      echo "# Removing ip address: $interface $addr"
      $FWBDEBUG "$IP" addr "$cmd" "$addr" dev "$interface" || exit 1
    }

    $FWBDEBUG "$IP" link set "$interface" up
}

list_addresses_by_scope() {
    interface=$1
    scope=$2
    ignore_list=$3
    "$IP" addr ls dev "$interface" | \
      awk -v IGNORED="$ignore_list" -v SCOPE="$scope" \
        'BEGIN {
           split(IGNORED,ignored_arr);
           for (a in ignored_arr) {ignored_dict[ignored_arr[a]]=1;}
         }
         (/inet |inet6 / && $0 ~ SCOPE && !($2 in ignored_dict)) {print $2;}' | \
        while read -r addr; do
          echo "${addr}@$interface"
	done | sort
}

update_addresses_of_interface() {
    ignore_list=$2
    # shellcheck disable=SC2086
    set -- $1
    interface=$1
    shift

    FWB_ADDRS=$(
      for addr in "$@"; do
        echo "${addr}@$interface"
      done | sort
    )

    CURRENT_ADDRS_ALL_SCOPES=""
    CURRENT_ADDRS_GLOBAL_SCOPE=""

    if "$IP" link show dev "$interface" >/dev/null 2>&1; then
      CURRENT_ADDRS_ALL_SCOPES=$(list_addresses_by_scope "$interface" 'scope .*' "$ignore_list")
      CURRENT_ADDRS_GLOBAL_SCOPE=$(list_addresses_by_scope "$interface" 'scope global' "$ignore_list")
    else
      echo "# Interface $interface does not exist"
      # Stop the script if we are not in test mode
      test -z "$FWBDEBUG" && exit 1
    fi

    diff_intf missing_address "$FWB_ADDRS" "$CURRENT_ADDRS_ALL_SCOPES" add
    diff_intf missing_address "$CURRENT_ADDRS_GLOBAL_SCOPE" "$FWB_ADDRS" del
}

clear_addresses_except_known_interfaces() {
    "$IP" link show | sed 's/://g' | awk -v IGNORED="$*" \
        'BEGIN {
           split(IGNORED,ignored_arr);
           for (a in ignored_arr) {ignored_dict[ignored_arr[a]]=1;}
         }
         (/state/ && !($2 in ignored_dict)) {print $2;}' | \
         while read -r intf; do
            echo "# Removing addresses not configured in fwbuilder from interface $intf"
            $FWBDEBUG "$IP" addr flush dev "$intf" scope global
            $FWBDEBUG "$IP" link set "$intf" down
         done
}

check_nft() {
    if [ ! -x "$NFT" ]; then
        echo "Error: nft not found at $NFT"
        exit 1
    fi
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

# An address table keeps its addresses in a file on this machine, so the set
# the rules match against is filled in here and not by the ruleset itself.
# Comments start with "#" or ";", and an address of the other family is
# skipped: the set is typed and would refuse it.
load_address_table() {
    family=$1
    table=$2
    setname=$3
    file=$4
    af=$5

    test -r "$file" || {
        echo "Can not find file $file referenced by address table object $setname"
        return 1
    }

    cleaned=$(sed -e 's/[#;].*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file" \
        | grep -v '^$')
    if [ "$af" = "-6" ]; then
        addrs=$(printf '%s\n' "$cleaned" | grep ':')
    else
        addrs=$(printf '%s\n' "$cleaned" | grep -v ':')
    fi
    addrs=$(printf '%s\n' "$addrs" | grep -v '^$' | paste -sd, -)

    test -n "$addrs" || return 0
    $NFT add element "$family" "$table" "$setname" "{ $addrs }"
}

# A DNS name is resolved on this machine, and nft refuses a hostname that
# resolves to more than one address - it rejects the whole ruleset over it.
# So the name is resolved here and its addresses go into the set the rules
# match against, which is what iptables does when it expands the name into
# one rule per address.
load_dns_name() {
    family=$1
    table=$2
    setname=$3
    host=$4
    af=$5

    if [ "$af" = "-6" ]; then
        addrs=$(getent ahostsv6 "$host" | awk '{print $1}' | sort -u | paste -sd, -)
    else
        addrs=$(getent ahostsv4 "$host" | awk '{print $1}' | sort -u | paste -sd, -)
    fi

    test -n "$addrs" || {
        echo "Can not resolve $host referenced by DNS name object $setname"
        return 0
    }
    $NFT add element "$family" "$table" "$setname" "{ $addrs }"
}

# The address of a dynamic interface is only known here, so the rules match
# against a set that is filled from the running interface. A wildcard name
# such as "ppp*" collects the addresses of every interface it matches, which
# is the same set of rules iptables writes one loop iteration at a time.
load_interface_address() {
    family=$1
    table=$2
    setname=$3
    pattern=$4
    af=$5

    addrs=""
    for dev in $($IP -o link show | sed 's/^[0-9]*: //;s/[@:].*//' | sort -u); do
        case "$dev" in
        $pattern) ;;
        *) continue ;;
        esac
        found=$($IP "$af" -o addr show dev "$dev" 2>/dev/null |
            awk '{print $4}' | sed 's!/.*!!')
        for a in $found; do
            addrs="${addrs:+$addrs,}$a"
        done
    done

    test -n "$addrs" || {
        test "$af" = "-6" && fam=IPv6 || fam=IPv4
        echo "No $fam address on any interface matching $pattern," \
             "so the rules using set $setname match nothing"
        return 0
    }
    $NFT add element "$family" "$table" "$setname" "{ $addrs }"
}

load_address_tables() {
    :
    load_interface_address "ip" "fwf_filter" "i_ppp0" "ppp0" "-4"
    load_interface_address "ip" "fwf_filter" "i_ppp1" "ppp1" "-4"
    load_interface_address "ip" "fwf_nat" "i_ppp0" "ppp0" "-4"
    load_interface_address "ip" "fwf_nat" "i_ppp1" "ppp1" "-4"
}

nft_ruleset() {
    cat <<'NFT_RULES'
table ip fwf_filter {}
delete table ip fwf_filter
table ip fwf_nat {}
delete table ip fwf_nat

table ip fwf_filter {
    set i_ppp0 {
        type ipv4_addr
        flags interval
        auto-merge
    }
    set i_ppp1 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain input {
        type filter hook input priority filter; policy drop;
        #
        # Rule 0 (ppp0)
        #
        iifname "ppp0" ip saddr != @i_ppp0 counter log drop
        iifname "ppp0" ip saddr != 192.168.1.0/24 counter log drop
        #
        # Rule 1 (ppp1)
        #
        iifname "ppp1" ip saddr != @i_ppp0 counter log drop
        iifname "ppp1" ip saddr != 192.168.1.0/24 counter log drop
        #
        # Rule 2 (ppp0,ppp1)
        #
        iifname "ppp0" ip saddr != @i_ppp0 counter log drop
        iifname "ppp1" ip saddr != @i_ppp0 counter log drop
        iifname "ppp0" ip saddr != @i_ppp1 counter log drop
        iifname "ppp1" ip saddr != @i_ppp1 counter log drop
        iifname "ppp0" ip saddr != 192.168.1.0/24 counter log drop
        iifname "ppp1" ip saddr != 192.168.1.0/24 counter log drop
        #
        # Rule 3 (global)
        #
        ip saddr @i_ppp0 ip daddr @i_ppp1 counter log drop
        #
        # Rule 4 (global)
        #
        ip daddr @i_ppp0 tcp dport 22 ct state new counter accept
        ip daddr @i_ppp1 tcp dport 22 ct state new counter accept
        #
        # Rule 6 (global)
        #
        tcp dport 22 ct state new counter accept
        #
        # Rule 7 (global)
        #
        ip daddr 192.168.1.1 tcp dport 22 ct state new counter accept
        #
        # Rule 12 (global)
        #
        # firewall is part of Any, compiler should
        # generate code for both FORWARD and
        # INPUT chains
        ip saddr 200.200.200.200 ct state new counter accept
        #
        # Rule 13 (global)
        #
        # because firewall has interface on network
        # internal_net, compiler should generate code
        # for both FORWARD and INPUT chains
        ip saddr 192.168.1.10 ip daddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 15 (global)
        #
        # Automatically generated 'catch all' rule
        counter log drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        #
        # Rule 0 (ppp0)
        #
        iifname "ppp0" ip saddr != @i_ppp0 counter log drop
        iifname "ppp0" ip saddr != 192.168.1.0/24 counter log drop
        #
        # Rule 1 (ppp1)
        #
        iifname "ppp1" ip saddr != @i_ppp0 counter log drop
        iifname "ppp1" ip saddr != 192.168.1.0/24 counter log drop
        #
        # Rule 2 (ppp0,ppp1)
        #
        iifname "ppp0" ip saddr != @i_ppp0 counter log drop
        iifname "ppp1" ip saddr != @i_ppp0 counter log drop
        iifname "ppp0" ip saddr != @i_ppp1 counter log drop
        iifname "ppp1" ip saddr != @i_ppp1 counter log drop
        iifname "ppp0" ip saddr != 192.168.1.0/24 counter log drop
        iifname "ppp1" ip saddr != 192.168.1.0/24 counter log drop
        #
        # Rule 5 (global)
        #
        # hostF has the same IP address as firewal.
        ip daddr 192.168.1.1 icmp type echo-request icmp code 0 ct state new counter log accept
        #
        # Rule 8 (global)
        #
        ip daddr 192.168.1.1 tcp dport { 22, 23 } ct state new counter accept
        #
        # Rule 9 (global)
        #
        ip daddr { 77.77.77.77, 192.168.1.1, 192.168.2.1 } tcp dport { 22, 23 } ct state new counter accept
        #
        # Rule 10 (global)
        #
        ip daddr { 77.77.77.77, 192.168.1.1, 192.168.2.1 } tcp dport { 22, 23 } ct state new counter log accept
        #
        # Rule 11 (global)
        #
        # firewall is part of Any, so compiler should
        # generate code in both FORWARD and
        # OUTPUT chains
        ip daddr 200.200.200.200 ct state new counter accept
        #
        # Rule 12 (global)
        #
        # firewall is part of Any, compiler should
        # generate code for both FORWARD and
        # INPUT chains
        ip saddr 200.200.200.200 ct state new counter accept
        #
        # Rule 13 (global)
        #
        # because firewall has interface on network
        # internal_net, compiler should generate code
        # for both FORWARD and INPUT chains
        ip saddr 192.168.1.10 ip daddr 192.168.1.0/24 ct state new counter accept
        #
        # Rule 14 (global)
        #
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr 200.200.200.200 ct state new counter accept
        #
        # Rule 15 (global)
        #
        # Automatically generated 'catch all' rule
        counter log drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        #
        # Rule 3 (global)
        #
        ip saddr @i_ppp0 ip daddr @i_ppp1 counter log drop
        #
        # Rule 4 (global)
        #
        ip daddr @i_ppp0 tcp dport 22 ct state new counter accept
        ip daddr @i_ppp1 tcp dport 22 ct state new counter accept
        #
        # Rule 5 (global)
        #
        # hostF has the same IP address as firewal.
        ip daddr 192.168.1.1 icmp type echo-request icmp code 0 ct state new counter log accept
        #
        # Rule 6 (global)
        #
        ip daddr { 192.168.1.1, 192.168.2.1 } tcp dport 22 ct state new counter accept
        ip daddr @i_ppp0 tcp dport 22 ct state new counter accept
        ip daddr @i_ppp1 tcp dport 22 ct state new counter accept
        #
        # Rule 7 (global)
        #
        ip daddr 192.168.1.1 tcp dport 22 ct state new counter accept
        #
        # Rule 8 (global)
        #
        ip daddr 192.168.1.1 tcp dport { 22, 23 } ct state new counter accept
        #
        # Rule 9 (global)
        #
        ip daddr { 77.77.77.77, 192.168.1.1, 192.168.2.1 } tcp dport { 22, 23 } ct state new counter accept
        #
        # Rule 10 (global)
        #
        ip daddr { 77.77.77.77, 192.168.1.1, 192.168.2.1 } tcp dport { 22, 23 } ct state new counter log accept
        #
        # Rule 11 (global)
        #
        # firewall is part of Any, so compiler should
        # generate code in both FORWARD and
        # OUTPUT chains
        ip daddr 200.200.200.200 ct state new counter accept
        #
        # Rule 14 (global)
        #
        ip saddr { 192.168.1.0/24, 192.168.2.0/24 } ip daddr 200.200.200.200 ct state new counter accept
        #
        # Rule 15 (global)
        #
        # Automatically generated 'catch all' rule
        counter log drop
    }
}

table ip fwf_nat {
    set i_ppp0 {
        type ipv4_addr
        flags interval
        auto-merge
    }
    set i_ppp1 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain prerouting {
        type nat hook prerouting priority dstnat;
        #
        # Rule 3 (NAT)
        #
        ip daddr 192.168.1.1 tcp dport 22 counter dnat to 192.168.1.10:22
        ip daddr 192.168.2.1 tcp dport 22 counter dnat to 192.168.1.10:22
        ip daddr @i_ppp0 tcp dport 22 counter dnat to 192.168.1.10:22
        ip daddr @i_ppp1 tcp dport 22 counter dnat to 192.168.1.10:22
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        #
        # Rule 0 (NAT)
        #
        oifname "eth2" ip saddr 192.168.1.0/24 counter snat to 192.168.2.1
        oifname "ppp0" ip saddr 192.168.1.0/24 counter masquerade
        oifname "ppp1" ip saddr 192.168.1.0/24 counter masquerade
        #
        # Rule 1 (NAT)
        #
        oifname "eth*" ip saddr 192.168.1.0/24 counter snat to 22.22.22.23
        oifname "ppp*" ip saddr 192.168.1.0/24 counter snat to 22.22.22.23
        #
        # Rule 2 (NAT)
        #
        oifname "eth*" ip saddr 77.77.77.77 counter snat to 22.22.22.23
        oifname "ppp*" ip saddr 77.77.77.77 counter snat to 22.22.22.23
        oifname "eth*" ip saddr 192.168.1.1 counter snat to 22.22.22.23
        oifname "ppp*" ip saddr 192.168.1.1 counter snat to 22.22.22.23
        oifname "eth*" ip saddr 192.168.2.1 counter snat to 22.22.22.23
        oifname "ppp*" ip saddr 192.168.2.1 counter snat to 22.22.22.23
    }
}

NFT_RULES
}

# nft parses and evaluates the whole batch before it installs anything, and
# refuses all of it over a single bad rule.  Asking first, while the running
# ruleset is still in place, is what keeps a rejected ruleset from turning
# into a firewall with no rules at all: the check touches nothing.
check_ruleset() {
    nft_ruleset | $NFT --check -f /dev/stdin
}

script_body() {
    nft_ruleset | $NFT -f /dev/stdin
    load_address_tables
}

ip_forward() {
    :

}

set_kernel_variables() {
    echo 30 > /proc/sys/net/ipv4/tcp_fin_timeout
    echo 1800 > /proc/sys/net/ipv4/tcp_keepalive_intvl
}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
    $NFT delete table inet fwf_mangle 2>/dev/null
    $NFT delete table ip fwf_mangle 2>/dev/null
    # Deleting a table that is not there fails, and most firewalls have no
    # mangle table, so without this the function would hand its caller the
    # exit code of a failed delete and "stop" would report failure.
    return 0
}

flush_legacy_iptables() {
    # Remove stale legacy (xtables) iptables rules left over from a
    # previous iptables-based policy. "nft flush ruleset" only clears
    # the nft backend, so on systems still using the legacy backend the
    # old iptables rules would otherwise survive and shadow the nft
    # rules. All filtering is delegated to nftables, so the built-in
    # policies are reset to ACCEPT and every chain is flushed/deleted.
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -P INPUT ACCEPT 2>/dev/null
        "$ipt" -P FORWARD ACCEPT 2>/dev/null
        "$ipt" -P OUTPUT ACCEPT 2>/dev/null
        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -F 2>/dev/null
            "$ipt" -t "$table" -X 2>/dev/null
        done
    done
    # Same as in flush_own_tables: a table the kernel does not offer makes
    # the last command fail, which must not become the caller's exit code.
    return 0
}

block_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
}

stop_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_nft
        prolog_commands
        check_ruleset || {
            log "Ruleset rejected by nft, keeping the running firewall"
            run_epilog_and_exit 1
        }
        stop_action
        set_kernel_variables
        script_body || run_epilog_and_exit 1
        ip_forward
        epilog_commands
        log "Firewall script is done"
        ;;

    stop)
        check_nft
        stop_action
        RETVAL=$?
        ;;

    status)
        check_nft
        status_action
        RETVAL=$?
        ;;

    block)
        check_nft
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 stop
        $0 start
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload]"
        RETVAL=1
        ;;

esac

exit "$RETVAL"
