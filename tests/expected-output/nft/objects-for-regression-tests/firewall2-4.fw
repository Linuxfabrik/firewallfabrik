#!/bin/sh
#
#  This file is managed by FirewallFabrik - do not edit
#
#  FirewallFabrik fwf-nft VERSION
#
#  Generated TIMESTAMP
#
# files: * firewall2-4.fw /etc/fw/fwf.sh
#
#  tests for error conditions in NATCompiler_ipt::VerifyRules
#
# Rule 0 (NAT): Can not use negation in translated source
# Rule 1 (NAT): Can not use negation in translated destination
# Rule 2 (NAT): Can not use negation in translated service
# Rule 3 (NAT): Translated service should be 'Original' or should contain single object.
# Rule 4 (NAT): Translated service should be 'Original' or should contain single object.
# Rule 7 (NAT): NAT branching rule misses branch rule set.
# Rule 9 (NAT): Can not use unnumbered interface in Translated Source of a Source translation rule.
# Rule 10 (NAT): Original and translated source should both be networks of the same size.
# Rule 12 (NAT): Can not use service object in Translated Service if Original Service is 'Any'.
# Rule 13 (NAT): Translated Service should be either 'Original' or should contain object of the same type as Original Service.
# Rule 14 (NAT): Translated Service should be either 'Original' or should contain object of the same type as Original Service.

FWBDEBUG=""
# Every branch of the case below is expected to leave an exit code here, and
# the one that prints the usage says 1.  Without the initialisation the
# script ends in `exit ""`, which the shell answers with "numeric argument
# required" and an exit code of its own choosing.  The iptables skeleton has
# had both lines since fwbuilder wrote it.
RETVAL=0

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="/usr/sbin/nft"
IP="/sbin/ip"
LOGGER="logger"

log() {
    echo "$1"
    command -v "$LOGGER" >/dev/null 2>&1 && $LOGGER -p info "$1"
}

getInterfaceVarName() {
    echo "$1" | sed 's/\./_/'
}

getaddr_internal() {
    dev=$1
    name=$2
    af=$3
    L=$("$IP" "$af" addr show dev "$dev" | sed -n '/inet/{s!.*inet6* !!;s!/.*!!p}' | sed 's/peer.*//')
    test -z "$L" && {
        eval "$name=''"
        return
    }
    eval "${name}_list=\"$L\""
}

getnet_internal() {
    dev=$1
    name=$2
    af=$3
    L=$("$IP" route list proto kernel | grep "$dev" | grep -v default | sed 's! .*$!!')
    test -z "$L" && {
        eval "$name=''"
        return
    }
    eval "${name}_list=\"$L\""
}

getaddr() {
    getaddr_internal "$1" "$2" "-4"
}

getaddr6() {
    getaddr_internal "$1" "$2" "-6"
}

getnet() {
    getnet_internal "$1" "$2" "-4"
}

getnet6() {
    getnet_internal "$1" "$2" "-6"
}

# function getinterfaces is used to process wildcard interfaces
getinterfaces() {
    NAME=$1
    "$IP" link show | grep ": $NAME" | while read -r L; do
        OIFS=$IFS
        IFS=" :"
        # shellcheck disable=SC2086
        set -- $L
        IFS=$OIFS
        echo "$2"
    done
}

diff_intf() {
    func=$1
    list1=$2
    list2=$3
    cmd=$4
    for intf in $list1
    do
        echo "$list2" | grep -q "$intf" || {
        # $intf is absent in list 2
            "$func" "$intf" "$cmd"
        }
    done
}

P2P_INTERFACE_WARNING=""

missing_address() {
    address=$1
    cmd=$2

    oldIFS=$IFS
    IFS="@"
    # shellcheck disable=SC2086
    set -- $address
    addr=$1
    interface=$2
    IFS=$oldIFS

    "$IP" addr show dev "$interface" | grep -q POINTOPOINT && {
        test -z "$P2P_INTERFACE_WARNING" && echo "Warning: Can not update address of interface $interface. fwbuilder can not manage addresses of point-to-point interfaces yet"
        P2P_INTERFACE_WARNING="yes"
        return
    }

    test "$cmd" = "add" && {
      echo "# Adding ip address: $interface $addr"
      if echo "$addr" | grep -q ':'; then
          $FWBDEBUG "$IP" addr "$cmd" "$addr" dev "$interface"
      else
          $FWBDEBUG "$IP" addr "$cmd" "$addr" broadcast + dev "$interface"
      fi
    }

    test "$cmd" = "del" && {
      echo "# Removing ip address: $interface $addr"
      $FWBDEBUG "$IP" addr "$cmd" "$addr" dev "$interface" || exit 1
    }

    $FWBDEBUG "$IP" link set "$interface" up
}

list_addresses_by_scope() {
    interface=$1
    scope=$2
    ignore_list=$3
    "$IP" addr ls dev "$interface" | \
      awk -v IGNORED="$ignore_list" -v SCOPE="$scope" \
        'BEGIN {
           split(IGNORED,ignored_arr);
           for (a in ignored_arr) {ignored_dict[ignored_arr[a]]=1;}
         }
         (/inet |inet6 / && $0 ~ SCOPE && !($2 in ignored_dict)) {print $2;}' | \
        while read -r addr; do
          echo "${addr}@$interface"
	done | sort
}

update_addresses_of_interface() {
    ignore_list=$2
    # shellcheck disable=SC2086
    set -- $1
    interface=$1
    shift

    FWB_ADDRS=$(
      for addr in "$@"; do
        echo "${addr}@$interface"
      done | sort
    )

    CURRENT_ADDRS_ALL_SCOPES=""
    CURRENT_ADDRS_GLOBAL_SCOPE=""

    if "$IP" link show dev "$interface" >/dev/null 2>&1; then
      CURRENT_ADDRS_ALL_SCOPES=$(list_addresses_by_scope "$interface" 'scope .*' "$ignore_list")
      CURRENT_ADDRS_GLOBAL_SCOPE=$(list_addresses_by_scope "$interface" 'scope global' "$ignore_list")
    else
      echo "# Interface $interface does not exist"
      # Stop the script if we are not in test mode
      test -z "$FWBDEBUG" && exit 1
    fi

    diff_intf missing_address "$FWB_ADDRS" "$CURRENT_ADDRS_ALL_SCOPES" add
    diff_intf missing_address "$CURRENT_ADDRS_GLOBAL_SCOPE" "$FWB_ADDRS" del
}

clear_addresses_except_known_interfaces() {
    "$IP" link show | sed 's/://g' | awk -v IGNORED="$*" \
        'BEGIN {
           split(IGNORED,ignored_arr);
           for (a in ignored_arr) {ignored_dict[ignored_arr[a]]=1;}
         }
         (/state/ && !($2 in ignored_dict)) {print $2;}' | \
         while read -r intf; do
            echo "# Removing addresses not configured in fwbuilder from interface $intf"
            $FWBDEBUG "$IP" addr flush dev "$intf" scope global
            $FWBDEBUG "$IP" link set "$intf" down
         done
}

# Every binary the script calls is looked for before it touches the
# firewall, the way the iptables side has done it since fwbuilder wrote
# `check_utilities`.  `command -v` and not `[ -x ]`: the tool paths may be
# a bare name, which is what the PATH above is set for, and `[ -x nft ]`
# answers a name with the file of that name in the working directory.
find_program() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "\"$1\" not found"
        exit 1
    }
}

check_tools() {
    find_program "$NFT"
    # $IP fills the sets a rule matching a dynamic interface address or an
    # address table points at, and installs the routing rules.  Without it
    # those sets stay empty - a set no packet is in - and the activation
    # still reports success.
    find_program "$IP"
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

configure_interfaces() {
    :
