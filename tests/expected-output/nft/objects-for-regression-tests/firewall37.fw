table ip fwf_filter {
    set _6bone.net__rt_ {
        type ipv4_addr
        flags interval
        auto-merge
    }
    set ny6ix.net__rt_ {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (global)
        #
        meta l4proto 50 ct state new counter accept
        meta l4proto 51 ct state new counter accept
        #
        # Rule 1 (global)
        #
        meta l4proto 50 ct state new counter log prefix "RULE 1 -- ACCEPT " level info accept
        meta l4proto 51 ct state new counter log prefix "RULE 1 -- ACCEPT " level info accept
        #
        # Rule 2 (global)
        #
        ip saddr { 22.22.23.22, 192.168.1.22, 192.168.2.1 } meta l4proto 50 ct state new counter accept
        ip saddr { 22.22.23.22, 192.168.1.22, 192.168.2.1 } meta l4proto 51 ct state new counter accept
        #
        # Rule 4 (global)
        #
        ip saddr { 22.22.23.22, 192.168.1.22, 192.168.2.1 } meta l4proto 50 ct state new counter log prefix "RULE 4 -- ACCEPT " level info accept
        ip saddr { 22.22.23.22, 192.168.1.22, 192.168.2.1 } meta l4proto 51 ct state new counter log prefix "RULE 4 -- ACCEPT " level info accept
        #
        # Rule 11 (global)
        #
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } meta l4proto 50 ct state new counter log prefix "RULE 11 -- ACCEPT " level info accept
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } meta l4proto 51 ct state new counter log prefix "RULE 11 -- ACCEPT " level info accept
        #
        # Rule 12 (eth1)
        #
        iifname "eth1" meta l4proto 50 ct state new counter accept
        iifname "eth1" meta l4proto 51 ct state new counter accept
        #
        # Rule 13 (eth1)
        #
        iifname "eth1" meta l4proto 50 ct state new counter accept
        iifname "eth1" meta l4proto 51 ct state new counter accept
        #
        # Rule 15 (global)
        #
        # using CONNMARK
        meta l4proto 50 ct state new counter accept
        meta l4proto 51 ct state new counter accept
        #
        # Rule 16 (global)
        #
        # using CONNMARK
        meta l4proto 50 ct state new counter log prefix "RULE 16 -- ACCEPT " level info accept
        meta l4proto 51 ct state new counter log prefix "RULE 16 -- ACCEPT " level info accept
        #
        # Rule 17 (global)
        #
        # using CONNMARK
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } meta l4proto 50 ct state new counter log prefix "RULE 17 -- ACCEPT " level info accept
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } meta l4proto 51 ct state new counter log prefix "RULE 17 -- ACCEPT " level info accept
        #
        # Rule 18 (eth1)
        #
        # using CONNMARK
        iifname "eth1" meta l4proto 50 ct state new counter accept
        iifname "eth1" meta l4proto 51 ct state new counter accept
        #
        # Rule 20 (global)
        #
        # tag 0 matches packet that has not been marked yet.
        meta mark != 0 ct state new counter accept
        #
        # Rule 22 (global)
        #
        ip saddr 192.168.1.0/24 counter accept
        #
        # Rule 23 (global)
        #
        ip saddr 192.168.1.0/24 counter log prefix "RULE 23 -- ACCEPT " level info accept
        #
        # Rule 24 (global)
        #
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } counter accept
        #
        # Rule 25 (global)
        #
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } counter log prefix "RULE 25 -- ACCEPT " level info accept
        #
        # Rule 26 (eth1)
        #
        iifname "eth1" ip saddr 192.168.1.0/24 counter accept
        #
        # Rule 27 (eth1)
        #
        iifname "eth1" ip saddr 192.168.1.0/24 counter log prefix "RULE 27 -- ACCEPT " level info accept
        #
        # Rule 28 (eth1)
        #
        iifname != "eth1" ip saddr 192.168.1.0/24 counter accept
        #
        # Rule 29 (eth1)
        #
        iifname != "eth1" ip saddr 192.168.1.0/24 counter log prefix "RULE 29 -- ACCEPT " level info accept
        #
        # Rule 31 (global)
        #
        # testing for bug #1618381
        # classify action is non-terminating
        # in this firewall object
        icmp type destination-unreachable counter accept
        #
        # Rule 32 (eth0)
        #
        # second rule for bug #1618381
        iifname "eth0" counter accept
        #
        # Rule 33 (global)
        #
        # testing for bug #1618381
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } icmp type destination-unreachable counter accept
        #
        # Rule 34 (global)
        #
        # testing for bug #1618381
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } icmp type destination-unreachable counter accept
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } tcp dport 80 counter accept
        #
        # Rule 35 (eth0)
