        # bug #1618381
        # this rule uses multiport
        # and has to be split because
        # of that
        iifname "eth0" tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } counter accept
        iifname "eth0" udp dport { 53, 161 } counter accept
        #
        # Rule 37 (global)
        #
        counter log prefix "RULE 37 -- BRANCH " level info jump mymark
        #
        # Rule 38 (global)
        #
        counter log prefix "RULE 38 -- DENY " level info drop
        #
        # Rule mangle_rules 0 (global)
        #
        meta mark != 0 ct state new counter accept
        #
        # Rule mangle_rules 1 (global)
        #
        tcp dport 80 ct state new counter accept
        #
        # Rule mangle_rules 2 (global)
        #
        meta mark 1 counter accept
        #
        # Rule mangle_rules 4 (global)
        #
        ip saddr 157.112.176.24 meta mark 1 ct state new counter accept
        #
        # Rule mangle_rules 5 (global)
        #
        ip saddr @_6bone.net__rt_ meta mark 1 ct state new counter accept
        #
        # Rule mangle_rules 6 (global)
        #
        ip saddr @_6bone.net__rt_ meta mark 1 ct state new counter accept
        ip saddr @ny6ix.net__rt_ meta mark 1 ct state new counter accept
        #
        # Rule mangle_rules 8 (global)
        #
        ip saddr { 22.22.23.22, 192.168.1.22, 192.168.2.1 } meta mark 1 ct state new counter accept
        #
        # Rule mangle_rules 9 (global)
        #
        ip saddr 22.22.23.22 meta mark 1 ct state new counter accept
        #
        # Rule mangle_rules 10 (global)
        #
        meta mark 1 ct state new counter accept
