        #
        # Rule 27 (eth1)
        #
        oifname "eth1" ip saddr 192.168.1.0/24 counter log prefix "RULE 27 -- ACCEPT " level info accept
        #
        # Rule 28 (eth1)
        #
        oifname != "eth1" ip saddr 192.168.1.0/24 counter accept
        #
        # Rule 29 (eth1)
        #
        oifname != "eth1" ip saddr 192.168.1.0/24 counter log prefix "RULE 29 -- ACCEPT " level info accept
        #
        # Rule 31 (global)
        #
        # testing for bug #1618381
        # classify action is non-terminating
        # in this firewall object
        icmp type destination-unreachable counter accept
        #
        # Rule 32 (eth0)
        #
