        oifname "eth1" ip saddr 22.22.23.22 meta l4proto 50 ct state new counter accept
        oifname "eth1" ip saddr 22.22.23.22 meta l4proto 51 ct state new counter accept
        #
        # Rule 6 (eth1)
        #
        oifname "eth1" ip saddr 22.22.23.22 meta l4proto 50 ct state new counter accept
        oifname "eth1" ip saddr 22.22.23.22 meta l4proto 51 ct state new counter accept
        #
        # Rule 7 (eth1)
        #
        oifname "eth1" meta l4proto 50 ct state new counter accept
        oifname "eth1" meta l4proto 51 ct state new counter accept
        #
        # Rule 8 (eth1)
        #
        oifname "eth1" ip saddr 22.22.23.22 meta l4proto 50 counter accept
        oifname "eth1" ip saddr 22.22.23.22 meta l4proto 51 counter accept
