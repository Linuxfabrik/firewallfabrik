        oifname "eth0" tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } counter meta priority set 1:11
        oifname "eth0" udp dport { 53, 161 } counter meta priority set 1:11
        #
        # Rule mangle_rules 2 (global)
        #
        meta mark 1 counter meta priority set 1:12
    }

    chain mymark {
        #
        # Rule mymark 0 (global)
        #
        ip daddr 192.168.2.0/24 ct state new counter meta mark set 16
        #
        # Rule mymark 1 (global)
        #
        ct state new counter meta mark set 2
