        #
        # Rule 23 (global)
        #
        ip saddr 192.168.1.0/24 counter meta priority set 1:2
        #
        # Rule 24 (global)
        #
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } counter meta priority set 1:2
        #
