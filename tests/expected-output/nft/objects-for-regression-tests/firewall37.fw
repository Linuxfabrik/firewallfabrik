        # bug #1618381
        # this rule uses multiport
        # and has to be split because
        # of that
        oifname "eth0" tcp dport { 113, 13, 53, 2105, 21, 70, 80, 443, 6667, 119, 25, 3128, 22, 23, 10000-11000, 540 } counter accept
        oifname "eth0" udp dport { 53, 161 } counter accept
        #
