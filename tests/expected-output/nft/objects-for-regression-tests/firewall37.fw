        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } icmp type destination-unreachable counter meta priority set 1:10
        ip saddr != { 192.168.1.0/24, 192.168.2.0/24 } tcp dport 80 counter meta priority set 1:10
        #
        # Rule 35 (eth0)
