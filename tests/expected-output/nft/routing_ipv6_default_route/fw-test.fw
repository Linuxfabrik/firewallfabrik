#!/bin/sh
# shellcheck disable=SC2034,SC2329
#
#  This file is managed by FirewallFabrik - do not edit
#
#  FirewallFabrik fwf-nft VERSION
#
#  Generated TIMESTAMP
#
# files: * fw-test.fw /etc/fwf.sh
#
# Compiled for nftables (any version)
#

FWBDEBUG=""
# Every branch of the case below is expected to leave an exit code here, and
# the one that prints the usage says 1.  Without the initialisation the
# script ends in `exit ""`, which the shell answers with "numeric argument
# required" and an exit code of its own choosing.  The iptables skeleton has
# had both lines since fwbuilder wrote it.
RETVAL=0

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="nft"
IP="ip"
LOGGER="logger"

log() {
    echo "$1"
    command -v logger > /dev/null 2>&1 && logger -p info "$1"
}

# Every binary the script calls is looked for before it touches the
# firewall, the way the iptables side has done it since fwbuilder wrote
# `check_utilities`.  `command -v` and not `[ -x ]`: the tool paths may be
# a bare name, which is what the PATH above is set for, and `[ -x nft ]`
# answers a name with the file of that name in the working directory.
find_program() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "\"$1\" not found"
        exit 1
    }
}

check_tools() {
    find_program "$NFT"
    # $IP fills the sets a rule matching a dynamic interface address or an
    # address table points at, and installs the routing rules.  Without it
    # those sets stay empty - a set no packet is in - and the activation
    # still reports success.
    find_program "$IP"
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

nft_ruleset() {
    cat <<'NFT_RULES'
table inet fwf_filter {}
delete table inet fwf_filter

table inet fwf_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        #
        # Rule 0 (global)
        #
        meta nfproto ipv6 ct state new counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        #
        # Rule 0 (global)
        #
        meta nfproto ipv6 ct state new counter drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        #
        # Rule 0 (global)
        #
        meta nfproto ipv6 ct state new counter drop
    }
}

NFT_RULES
}

# nft parses and evaluates the whole batch before it installs anything, and
# refuses all of it over a single bad rule.  Asking first, while the running
# ruleset is still in place, is what keeps a rejected ruleset from turning
# into a firewall with no rules at all: the check touches nothing.
check_ruleset() {
    nft_ruleset | $NFT --check -f /dev/stdin
}

script_body() {
    nft_ruleset | $NFT -f /dev/stdin
}

routing_script() {

# ============== ROUTING RULES ==============

HAVE_MKTEMP=$(command -v mktemp)

test -n "$HAVE_MKTEMP" && {
  TMPDIRNAME=$(mktemp -d)
  test -z "$TMPDIRNAME" && exit 1
}

test -z "$HAVE_MKTEMP" && {
  TMPDIRNAME="/tmp/.fwbuilder.tempdir.$$"
  (umask 077 && mkdir "$TMPDIRNAME") || exit 1
}

TMPFILENAME="$TMPDIRNAME/.fwbuilder.out"
OLD_ROUTES="$TMPDIRNAME/.old_routes"

#
# This function stops stdout redirection
# and sends previously saved output to terminal
restore_script_output()
{
  exec 1>&3 2>&1
  cat "$TMPFILENAME"
  rm -rf "$TMPDIRNAME"
}

# if any routing rule fails we do our best to prevent freezing the firewall
route_command_error()
{
  echo "Error: Routing rule $1 couldn't be activated"
  echo "Recovering previous routing configuration..."
  # delete current routing rules
  # A route is several arguments, so the expansion is split on purpose.
  # shellcheck disable=SC2086
  "$IP" -o route show | tr -d '\134' | while read -r route ; do "$IP" route del $route ; done
  # shellcheck disable=SC2086
  "$IP" -o -6 route show | tr -d '\134' | while read -r route ; do "$IP" -6 route del $route ; done
  # restore old routing rules
  sh "$OLD_ROUTES"
  echo "...done"
  restore_script_output
  epilog_commands
  exit 1
}

# redirect output to prevent ssh session from stalling
exec 3>&1
exec 1> "$TMPFILENAME"
exec 2>&1

# store previous routing configuration (sort: 'via' GW has to be
# inserted after device routes).  "-o" puts a route with several next
# hops on one line, where "ip route show" spreads it over one line per
# hop: read line by line, "default" and "nexthop via ..." are three
# commands, and the two the loops below would build out of the tail are
# not routes at all.  The separator "-o" writes in their place is a
# backslash, which is not part of any route and is spelled in octal
# because shellcheck reads a doubled one inside single quotes as an
# attempt at escaping the quote (SC1003).

"$IP" -o route show | tr -d '\134' | sort -k 2 | awk '{printf "ip route add %s\n",$0;}' > "$OLD_ROUTES"
# "ip route" is the IPv4 table and nothing else, and this script installs
# an IPv6 route as well, so the other table is saved, cleared and put back
# beside it - or the route is still there on the next activation and
# "ip -6 route add" answers "File exists", which stops the script.
"$IP" -o -6 route show | tr -d '\134' | sort -k 2 | awk '{printf "ip -6 route add %s\n",$0;}' >> "$OLD_ROUTES"

echo "Deleting routing rules previously set by user space processes..."
# A route is several arguments, so the expansion is split on purpose.
# shellcheck disable=SC2086
"$IP" -o route show | tr -d '\134' | grep -v '\( proto kernel \)\|\(default via \)' | \
    while read -r route ; do "$IP" route del $route ; done
# shellcheck disable=SC2086
"$IP" -o -6 route show | tr -d '\134' | grep -v 'proto kernel' | \
    while read -r route ; do "$IP" -6 route del $route ; done

echo "Activating non-ecmp routing rules..."
$IP -6 route add default via 2001:db8::ff dev eth0 \
|| route_command_error "0 (main)"

restore_script_output
echo "...done."

}

ip_forward() {
    :

}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
    $NFT delete table inet fwf_mangle 2>/dev/null
    $NFT delete table ip fwf_mangle 2>/dev/null
    # Deleting a table that is not there fails, and most firewalls have no
    # mangle table, so without this the function would hand its caller the
    # exit code of a failed delete and "stop" would report failure.
    return 0
}

# The tables this ruleset installs, in the form "nft list tables" prints.
FWF_OWN_TABLES='table inet fwf_filter'

# Everything else, removed once the new ruleset is in place.
#
# nft loads a ruleset atomically and the one above deletes and recreates
# each of its own tables in that same transaction, so their rules are
# never missing for an instant.  Removing the old rules first undoes
# exactly that: a table that is gone hooks nothing and every packet goes
# through, and the machine has no firewall at all until the load
# finishes.  The iptables side has no such gap - its reset sets the three
# built-in policies to DROP before it flushes anything - and this is what
# gives nftables the same guarantee.
#
# The deletes go into one batch of their own, so a name that has to be
# quoted survives the round trip through "nft list tables" untouched.
remove_other_tables() {
    $NFT list tables 2>/dev/null |
        while read -r line; do
            printf '%s\n' "$FWF_OWN_TABLES" | grep -qxF "$line" && continue
            # Coexistence: another tool's table is left alone, and
            # only a table of ours this ruleset no longer installs goes.
            case $line in
            "table inet fwf_filter" | "table ip fwf_filter" \
            | "table ip6 fwf_filter" \
            | "table inet fwf_mangle" | "table ip fwf_mangle" \
            | "table ip6 fwf_mangle" \
            | "table inet fwf_nat" | "table ip fwf_nat" \
            | "table ip6 fwf_nat") ;;
            *) continue ;;
            esac
            printf 'delete %s\n' "$line"
        done |
        $NFT -f - 2>/dev/null
    return 0
}

block_action() {
    flush_own_tables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
}

stop_action() {
    flush_own_tables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_tools
        prolog_commands
        check_ruleset || {
            log "Ruleset rejected by nft, keeping the running firewall"
            run_epilog_and_exit 1
        }
        script_body || run_epilog_and_exit 1
        remove_other_tables
        routing_script
        ip_forward
        epilog_commands
        log "Firewall script is done"
        ;;

    stop)
        check_tools
        stop_action
        RETVAL=$?
        ;;

    status)
        check_tools
        status_action
        RETVAL=$?
        ;;

    block)
        check_tools
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 start
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload]"
        RETVAL=1
        ;;

esac

exit "$RETVAL"
