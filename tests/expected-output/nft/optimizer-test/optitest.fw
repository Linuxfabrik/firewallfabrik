        #
        # Test 9 : Optimize on service - srcs -> user chain
        #             Dst to stay on rule in FORWARD table
        # + options TCP RST Reject Test
        ip saddr { 10.0.1.1, 10.0.1.2, 10.0.1.3 } ip daddr 10.0.0.1 tcp dport 80 counter reject with tcp reset
        #
        # Rule 29 (global)
        #
        # Test 10 : Optimize on src & dst, services -> user chain
        # + Logging
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 meta l4proto icmp ct state new limit rate 5/second counter log prefix "RULE 29 -- ACCEPT " level info
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 meta l4proto icmp ct state new counter accept
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 tcp dport 80 ct state new limit rate 5/second counter log prefix "RULE 29 -- ACCEPT " level info
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 tcp dport 80 ct state new counter accept
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 udp dport 873 ct state new limit rate 5/second counter log prefix "RULE 29 -- ACCEPT " level info
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 udp dport 873 ct state new counter accept
        #
        # Rule 30 (global)
        #
        # Test 11 : Special case - with multiport we shouldn't
        # optimize here as all services are TCP and we have <15
        # of them
        # NOT OPTIMUM - We've split before multiport which re-merges multiple services of the same type
        # SOLUTION ?
        ip saddr 10.0.1.1 ip daddr 10.0.0.1 tcp dport { 21, 80 } ct state new counter accept
        #
        # Rule 31 (global)
        #
        # Test 12 : Optimize : src, dst, svc
        # + options limit test
        # + logging
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto icmp ct state new limit rate 5/second counter log prefix "RULE 31 -- ACCEPT " level info
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto icmp ct state new limit rate 8/second burst 4 packets counter accept
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 21 ct state new limit rate 5/second counter log prefix "RULE 31 -- ACCEPT " level info
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 21 ct state new limit rate 8/second burst 4 packets counter accept
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } udp dport 873 ct state new limit rate 5/second counter log prefix "RULE 31 -- ACCEPT " level info
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } udp dport 873 ct state new limit rate 8/second burst 4 packets counter accept
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto 51 ct state new limit rate 5/second counter log prefix "RULE 31 -- ACCEPT " level info
        ip saddr 10.0.1.2 ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto 51 ct state new limit rate 8/second burst 4 packets counter accept
        #
        # Rule 32 (global)
        #
        # Test 13 : Optimize : src, dst, svc
        # Time should appear on the src rules in the FORWARD table
        # +Logging
        # NOT OPTIMUM : Time appears in Logging
        # SOLUTION : Patch logging not to include time?
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto icmp ct state new meta hour 0-43140 limit rate 5/second counter log prefix "RULE 32 -- ACCEPT " level info
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto icmp ct state new meta hour 0-43140 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 21 ct state new meta hour 0-43140 limit rate 5/second counter log prefix "RULE 32 -- ACCEPT " level info
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 21 ct state new meta hour 0-43140 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } udp dport 873 ct state new meta hour 0-43140 limit rate 5/second counter log prefix "RULE 32 -- ACCEPT " level info
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } udp dport 873 ct state new meta hour 0-43140 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto 51 ct state new meta hour 0-43140 limit rate 5/second counter log prefix "RULE 32 -- ACCEPT " level info
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto 51 ct state new meta hour 0-43140 counter accept
        #
        # Rule 33 (global)
        #
        # Test 14 : Optimize : src, dst, svc
        # Time should appear on the service rules
        # since we there are two of them and we don't optimize
        # for time (yet!)
        # + Logging
        # NOT OPTIMUM : Time appears in Logging
        # SOLUTION : Patch logging not to include time?
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto icmp ct state new meta hour 43200-86340 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 21 ct state new meta hour 43200-86340 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } udp dport 873 ct state new meta hour 43200-86340 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto 51 ct state new meta hour 43200-86340 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto icmp ct state new meta hour 0-43140 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 21 ct state new meta hour 0-43140 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } udp dport 873 ct state new meta hour 0-43140 counter accept
        ip saddr { 10.0.1.1, 10.0.1.2 } ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } meta l4proto 51 ct state new meta hour 0-43140 counter accept
        #
        # Rule 34 (global)
        #
        # Test 15 : Don't optimize if we have limit options
        ip saddr 10.0.1.1 ip daddr 10.0.0.2 tcp dport 80 limit rate 8/second burst 4 packets counter reject with tcp reset
        #
        # Rule 35 (global)
        #
        # Test 16 : Check INPUT/OUPUT with FW part of rule
        ip daddr 10.0.0.1 tcp dport 21 limit rate 5/second counter log prefix "RULE 35 -- DENY " level info
        ip daddr 10.0.0.1 tcp dport 21 counter drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        ct state established,related counter accept
    }
}

NFT_RULES
}

ip_forward() {
    :
    echo 1 > /proc/sys/net/ipv4/ip_forward
}

flush_own_tables() {
    # remove only our own tables, leaving other tools' tables untouched
    $NFT delete table inet fwf_filter 2>/dev/null
    $NFT delete table ip fwf_filter 2>/dev/null
    $NFT delete table inet fwf_nat 2>/dev/null
    $NFT delete table ip fwf_nat 2>/dev/null
    $NFT delete table ip6 fwf_nat 2>/dev/null
}

flush_legacy_iptables() {
    # Remove stale legacy (xtables) iptables rules left over from a
    # previous iptables-based policy. "nft flush ruleset" only clears
    # the nft backend, so on systems still using the legacy backend the
    # old iptables rules would otherwise survive and shadow the nft
    # rules. All filtering is delegated to nftables, so the built-in
    # policies are reset to ACCEPT and every chain is flushed/deleted.
    for ipt in iptables ip6tables; do
        command -v "$ipt" >/dev/null 2>&1 || continue
        "$ipt" -P INPUT ACCEPT 2>/dev/null
        "$ipt" -P FORWARD ACCEPT 2>/dev/null
        "$ipt" -P OUTPUT ACCEPT 2>/dev/null
        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -F 2>/dev/null
            "$ipt" -t "$table" -X 2>/dev/null
        done
    done
}

block_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
    # block all traffic by default (always use inet to block both IPv4 and IPv6)
    $NFT add table inet fwf_filter
    $NFT add chain inet fwf_filter input '{ type filter hook input priority 0; policy drop; }'
    $NFT add chain inet fwf_filter forward '{ type filter hook forward priority 0; policy drop; }'
    $NFT add chain inet fwf_filter output '{ type filter hook output priority 0; policy drop; }'
}

stop_action() {
    $NFT flush ruleset 2>/dev/null
    flush_legacy_iptables
}

check_nft_status() {
    tables=$($NFT list tables 2>/dev/null)
    if echo "$tables" | grep -q 'fwf_filter'; then
        return 0
    fi
    return 3
}

status_action() {
    check_nft_status
    ret=$?
    if [ $ret -eq 0 ]; then
        echo "Firewall is active"
        return 0
    fi
    echo "Firewall is not configured"
    exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated TIMESTAMP"
        check_nft
        prolog_commands
        stop_action
        script_body || run_epilog_and_exit 1
        ip_forward
        epilog_commands
        log "Firewall script is done"
        RETVAL=$?
        ;;

    stop)
        check_nft
        stop_action
        RETVAL=$?
        ;;

    status)
        check_nft
        status_action
        RETVAL=$?
        ;;

    block)
        check_nft
        block_action
        RETVAL=$?
        ;;

    reload)
        $0 stop
        $0 start
        RETVAL=$?
        ;;

    *)
        echo "Usage $0 [start|stop|status|block|reload]"
        ;;

esac

exit "$RETVAL"
