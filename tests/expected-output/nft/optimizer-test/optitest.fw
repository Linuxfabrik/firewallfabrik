FWBDEBUG=""
# Every branch of the case below is expected to leave an exit code here, and
# the one that prints the usage says 1.  Without the initialisation the
# script ends in `exit ""`, which the shell answers with "numeric argument
# required" and an exit code of its own choosing.  The iptables skeleton has
# had both lines since fwbuilder wrote it.
RETVAL=0

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="/usr/sbin/nft"

log() {
    echo "$1"
    command -v logger > /dev/null 2>&1 && logger -p info "$1"
}

check_nft() {
    if [ ! -x "$NFT" ]; then
        echo "Error: nft not found at $NFT"
        exit 1
    fi
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

nft_ruleset() {
    cat <<'NFT_RULES'
table ip fwf_filter {}
delete table ip fwf_filter

table ip fwf_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 16 (eth0)
        #
        # Test 16 : Check INPUT/OUPUT with FW part of rule
        iifname "eth0" tcp dport 21 limit rate 5/second counter log prefix "RULE 16 -- DENY " level info
        iifname "eth0" tcp dport 21 counter drop
        #
        # Rule 35 (global)
        #
        # Test 16 : Check INPUT/OUPUT with FW part of rule
        tcp dport 21 limit rate 5/second counter log prefix "RULE 35 -- DENY " level info
        tcp dport 21 counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 0 (eth0)
        #
        # Test 1 : Don't Optimize 1 dst
        iifname "eth0" ip daddr 10.0.0.1 ct state new counter accept
        oifname "eth0" ip daddr 10.0.0.1 ct state new counter accept
        #
        # Rule 1 (eth0)
        #
        # Test 2 : Don't Optimize 1 service
        iifname "eth0" tcp dport 80 ct state new counter accept
        oifname "eth0" tcp dport 80 ct state new counter accept
        #
        # Rule 2 (eth0)
        #
        # Test 3 : Don't Optimize 1 src & 1 dst
        iifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 ct state new counter accept
        oifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 ct state new counter accept
        #
        # Rule 3 (eth0)
        #
        # Test 4 : Don't Optimize 1 src & 1 service
        iifname "eth0" ip saddr 10.0.1.1 tcp dport 80 ct state new counter accept
        oifname "eth0" ip saddr 10.0.1.1 tcp dport 80 ct state new counter accept
        #
        # Rule 4 (eth0)
        #
        # Test 5 : Don't Optimize 1 dst & 1 service
        iifname "eth0" ip daddr 10.0.0.1 tcp dport 80 ct state new counter accept
        oifname "eth0" ip daddr 10.0.0.1 tcp dport 80 ct state new counter accept
        #
        # Rule 5 (eth0)
        #
        # Test 6 : Don't Optimize 1 src, 1 dst & 1 service
        iifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 tcp dport 80 ct state new counter accept
        oifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 tcp dport 80 ct state new counter accept
        #
        # Rule 7 (eth0)
        #
        # Test 7 : Optimize on service - dsts -> user chain
        iifname "eth0" ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 80 ct state new counter accept
        oifname "eth0" ip daddr { 10.0.0.1, 10.0.0.2, 10.0.0.3 } tcp dport 80 ct state new counter accept
        #
        # Rule 8 (eth0)
        #
        # Test 8 : Optimize on service - srcs -> user chain
        iifname "eth0" ip saddr { 10.0.1.1, 10.0.1.2, 10.0.1.3 } tcp dport 80 ct state new counter accept
        oifname "eth0" ip saddr { 10.0.1.1, 10.0.1.2, 10.0.1.3 } tcp dport 80 ct state new counter accept
        #
        # Rule 9 (eth0)
        #
        # Test 9 : Optimize on service - srcs -> user chain
        #             Dst to stay on rule in FORWARD table
        # + options TCP RST Reject Test
        iifname "eth0" ip saddr { 10.0.1.1, 10.0.1.2, 10.0.1.3 } ip daddr 10.0.0.1 tcp dport 80 counter reject with tcp reset
        oifname "eth0" ip saddr { 10.0.1.1, 10.0.1.2, 10.0.1.3 } ip daddr 10.0.0.1 tcp dport 80 counter reject with tcp reset
        #
