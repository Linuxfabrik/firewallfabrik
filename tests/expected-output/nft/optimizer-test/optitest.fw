        #
        # Test 3 : Don't Optimize 1 src & 1 dst
        iifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 ct state new counter accept
        oifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 ct state new counter accept
        #
        # Rule 3 (eth0)
        #
        # Test 4 : Don't Optimize 1 src & 1 service
