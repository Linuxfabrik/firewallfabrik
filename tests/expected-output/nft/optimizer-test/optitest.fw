        iifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 meta l4proto icmp ct state new limit rate 5/second counter log prefix "RULE 10 -- ACCEPT " level info
        iifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 meta l4proto icmp ct state new counter accept
        iifname "eth0" ip saddr 10.0.1.1 ip daddr 10.0.0.1 tcp dport 80 ct state new limit rate 5/second counter log prefix "RULE 10 -- ACCEPT " level info
