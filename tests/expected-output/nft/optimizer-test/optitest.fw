FWBDEBUG=""

PATH="/sbin:/usr/sbin:/bin:/usr/bin:${PATH}"
export PATH

NFT="/usr/sbin/nft"

log() {
    echo "$1"
    command -v logger > /dev/null 2>&1 && logger -p info "$1"
}

check_nft() {
    if [ ! -x "$NFT" ]; then
        echo "Error: nft not found at $NFT"
        exit 1
    fi
}

prolog_commands() {
    echo "Running prolog script"

    echo "Prolog script done"
}

epilog_commands() {
    echo "Running epilog script"

    echo "Epilog script done"
}

run_epilog_and_exit() {
    epilog_commands
    exit "$1"
}

script_body() {
    $NFT -f /dev/stdin <<'NFT_RULES'
table ip fwf_filter {}
delete table ip fwf_filter

table ip fwf_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related counter accept
        #
        # Rule 16 (eth0)
        #
        # Test 16 : Check INPUT/OUPUT with FW part of rule
        iifname "eth0" tcp dport 21 limit rate 5/second counter log prefix "RULE 16 -- DENY " level info
        iifname "eth0" tcp dport 21 counter drop
        #
        # Rule 35 (global)
        #
        # Test 16 : Check INPUT/OUPUT with FW part of rule
        tcp dport 21 limit rate 5/second counter log prefix "RULE 35 -- DENY " level info
