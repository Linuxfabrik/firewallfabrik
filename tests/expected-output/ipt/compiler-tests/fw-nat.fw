script_body() {
 :
 # ================ IPv4

 # ================ Table 'filter', automatic rules
 # accept established sessions
 $IPTABLES -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
 $IPTABLES -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
 $IPTABLES -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

 # ================ Table 'nat', rule set NAT
 #
 # Rule 0 (NAT)
 #
 echo "Rule 0 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.0/24 -j SNAT --to-source 198.51.100.1
 #
 # Rule 1 (NAT)
 #
 echo "Rule 1 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A PREROUTING -p tcp -m tcp -d 198.51.100.1 --dport 80 -j DNAT --to-destination 10.0.0.53
 #
 # Rule 2 (NAT)
 #
 echo "Rule 2 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A POSTROUTING -s 192.168.1.0/24 -j ACCEPT
 $IPTABLES -w 5 -t nat -A PREROUTING -s 192.168.1.0/24 -j ACCEPT
 #
 # Rule 3 (NAT)
 #
 echo "Rule 3 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A PREROUTING -p tcp -m tcp -d 10.0.0.1 --dport 80 -j REDIRECT --to-ports 8080
 $IPTABLES -w 5 -t nat -A PREROUTING -p tcp -m tcp -d 192.168.1.1 --dport 80 -j REDIRECT --to-ports 8080
 $IPTABLES -w 5 -t nat -A PREROUTING -p tcp -m tcp -d 198.51.100.1 --dport 80 -j REDIRECT --to-ports 8080
 #
 # Rule 4 (NAT)
 #
 echo "Rule 4 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth2 -s 192.168.1.0/24 -j SNAT --to-source 10.0.0.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.0/24 -j SNAT --to-source 198.51.100.1
 #
 # Rule 5 (NAT)
 #
 echo "Rule 5 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth2 -j SNAT --to-source 10.0.0.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth1 -j SNAT --to-source 192.168.1.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -j SNAT --to-source 198.51.100.1
 #
 # Rule 6 (NAT)
 #
 echo "Rule 6 (NAT)"
 #
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth2 -d 10.0.0.1 -j SNAT --to-source 10.0.0.1
 #
 # Rule 7 (NAT)
 #
 echo "Rule 7 (NAT)"
 #
 # Translated source is a range covering a whole prefix, plus a port range
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -p tcp -m tcp -s 192.168.1.0/24 --dport 80 -j SNAT --to-source 203.0.113.0-203.0.113.255:1024-2048
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth1 -p tcp -m tcp -s 192.168.1.0/24 --dport 80 -j SNAT --to-source 203.0.113.0-203.0.113.255:1024-2048
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth2 -p tcp -m tcp -s 192.168.1.0/24 --dport 80 -j SNAT --to-source 203.0.113.0-203.0.113.255:1024-2048
 #
 # Rule 8 (NAT)
 #
 echo "Rule 8 (NAT)"
 #
 # Translated source ports name an end but no start
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -p tcp -m tcp -s 192.168.1.0/24 --dport 443 -j SNAT --to-source 198.51.100.1:0-1024
 #
 # Rule 9 (NAT)
 #
 echo "Rule 9 (NAT)"
 #
 # Original service matches ICMP as a whole
 $IPTABLES -w 5 -t nat -A PREROUTING -p icmp -m icmp -d 198.51.100.1 --icmp-type any -j DNAT --to-destination 10.0.0.53
 #
 # Rule 10 (NAT)
 #
 echo "Rule 10 (NAT)"
 #
 # Original service holds more services than one -m multiport match can carry
 $IPTABLES -w 5 -t nat -A PREROUTING -p tcp -m tcp -m multiport -d 198.51.100.1 --dports 5190,1494,709,710,1720,3268,3269,2000,5631,7070,2998,445,49,548,113 -j DNAT --to-destination 10.0.0.53
 $IPTABLES -w 5 -t nat -A PREROUTING -p tcp -m tcp -d 198.51.100.1 --dport 179 -j DNAT --to-destination 10.0.0.53
 #
 # Rule 13 (NAT)
 #
 echo "Rule 13 (NAT)"
 #
 # Asks for the MASQUERADE target instead of SNAT
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.0/24 -j MASQUERADE
 #
 # Rule 14 (NAT)
 #
 echo "Rule 14 (NAT)"
 #
 # Masquerades into a source port range, with an original service that names no protocol
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -p tcp -m tcp -s 192.168.1.0/24 -m owner --uid-owner 500 -j MASQUERADE --to-ports 61000-65095
 #
 # Rule 15 (NAT)
 #
 echo "Rule 15 (NAT)"
 #
 # Maps a whole network 1:1, with an original service that names no protocol
 $IPTABLES -w 5 -t nat -A POSTROUTING -s 192.168.1.0/24 -m owner --uid-owner 500 -j NETMAP --to 198.51.100.0/24
 #
 # Rule 16 (NAT)
 #
 echo "Rule 16 (NAT)"
 #
 # Original source is an address range that is no prefix
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.100/30 -j SNAT --to-source 198.51.100.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.104/29 -j SNAT --to-source 198.51.100.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.112/28 -j SNAT --to-source 198.51.100.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.128/26 -j SNAT --to-source 198.51.100.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.192/29 -j SNAT --to-source 198.51.100.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -s 192.168.1.200 -j SNAT --to-source 198.51.100.1
 #
 # Rule 17 (NAT)
 #
 echo "Rule 17 (NAT)"
 #
 # Original service names two connection owners
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -m owner --uid-owner 500 -j SNAT --to-source 198.51.100.1
 $IPTABLES -w 5 -t nat -A POSTROUTING -o eth0 -m owner --uid-owner 501 -j SNAT --to-source 198.51.100.1

 # ================ Table 'filter', rule set Policy
 #
 # Rule 0 (global)
 #
 echo "Rule 0 (global)"
 #
 $IPTABLES -w 5 -A INPUT -s 192.168.1.0/24 -m conntrack --ctstate NEW -j ACCEPT
 $IPTABLES -w 5 -A FORWARD -i + -s 192.168.1.0/24 -m conntrack --ctstate NEW -j ACCEPT
 #
 # Rule 1 (global)
 #
 echo "Rule 1 (global)"
 #
 $IPTABLES -w 5 -A FORWARD -i + -p tcp -m tcp -d 10.0.0.53 --dport 80 -m conntrack --ctstate NEW -j ACCEPT
 #
 # Rule 2 (global)
 #
 echo "Rule 2 (global)"
 #
 $IPTABLES -w 5 -N RULE_2 2>/dev/null
 $IPTABLES -w 5 -A OUTPUT -j RULE_2
 $IPTABLES -w 5 -A INPUT -j RULE_2
 $IPTABLES -w 5 -A FORWARD -j RULE_2
 $IPTABLES -w 5 -A RULE_2 -j LOG --log-level info --log-prefix "RULE 2 -- DENY "
 $IPTABLES -w 5 -A RULE_2 -j DROP

 # ================ IPv6

 # ================ Table 'nat', rule set NAT_ipv6
 #
 # Rule NAT_ipv6 0 (NAT)
 #
 echo "Rule NAT_ipv6 0 (NAT)"
 #
 # Original service matches fragmented packets
 $IP6TABLES -w 5 -t nat -N NAT_ipv6_PREROUTING
 $IP6TABLES -w 5 -t nat -A NAT_ipv6_PREROUTING -p 0 -d 2001:db8:1::1 -m frag --fragmore -j DNAT --to-destination 2001:db8:3::53
}

ip_forward() {
 :
 echo 1 > /proc/sys/net/ipv4/ip_forward
}

reset_all() {
 :
 command -v nft >/dev/null 2>&1 && nft flush ruleset
 reset_iptables_v4
 reset_iptables_v6
}

block_action() {
 reset_all
}

stop_action() {
 reset_all
 $IPTABLES -w 5 -P OUTPUT ACCEPT
 $IPTABLES -w 5 -P INPUT ACCEPT
 $IPTABLES -w 5 -P FORWARD ACCEPT
 $IP6TABLES -w 5 -P OUTPUT ACCEPT
 $IP6TABLES -w 5 -P INPUT ACCEPT
 $IP6TABLES -w 5 -P FORWARD ACCEPT
}

status_action() {
 # Full-flush mode: check if iptables has user-defined chains
 # (more than just the three built-in chains INPUT/FORWARD/OUTPUT).
 chains=$($IPTABLES -w 5 -L -n 2>/dev/null | grep -c "^Chain ")
 [ "$chains" -gt 3 ] && {
 echo "Firewall is active"
 return 0
 }
 echo "Firewall is not configured"
 exit 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
 cmd="start"
}

case "$cmd" in
 start)
 log "Activating firewall script generated TIMESTAMP"
 check_tools
 prolog_commands
 check_run_time_address_table_files

 load_modules "nat ipv6"
 configure_interfaces
 verify_interfaces

 reset_all


 script_body || run_epilog_and_exit 1
 ip_forward

 epilog_commands
 ;;

 stop)
 check_tools
 stop_action
 RETVAL=$?
 ;;

 status)
 check_tools
 status_action
 RETVAL=$?
 ;;

 block)
 check_tools
 block_action
 RETVAL=$?
 ;;

 reload)
 $0 stop
 $0 start
 RETVAL=$?
 ;;

 interfaces)
 check_tools
 configure_interfaces
 RETVAL=$?
 ;;

 test_interfaces)
 check_tools
 FWBDEBUG="echo"
 configure_interfaces
 RETVAL=$?
 ;;

 *)
 echo "Usage $0 [start|stop|status|block|reload|interfaces|test_interfaces]"
 RETVAL=1
 ;;

esac

exit $RETVAL
