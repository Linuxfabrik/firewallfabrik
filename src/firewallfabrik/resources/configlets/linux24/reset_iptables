##
## Configlets support simple macro language with these constructs:
## {{$var}} is variable expansion
## {{if var}} is conditional operator.
##
# The tables to clear.  /proc/net/ip_tables_names, which used to be
# read here, only exists while the legacy ip_tables module is loaded;
# with the iptables-nft backend that every current distribution ships it
# is absent, the loop over it ran zero times and nothing was cleared at
# all, while the policies below were already set to DROP.  Naming the
# tables works with either backend: flushing one that does not exist is
# a no-op and leaves no table behind.
FWF_TABLES="filter mangle nat raw security"

reset_iptables_v4() {
  $IPTABLES {{$opt_wait}} -P OUTPUT  DROP
  $IPTABLES {{$opt_wait}} -P INPUT   DROP
  $IPTABLES {{$opt_wait}} -P FORWARD DROP

  for table in $FWF_TABLES; do
      list=$($IPTABLES {{$opt_wait}} -t "$table" -L -n 2>/dev/null) || continue
      printf "%s" "$list" | while read -r c chain rest; do
      if test "$c" = "Chain" ; then
        $IPTABLES {{$opt_wait}} -t "$table" -F "$chain"
      fi
      done
      $IPTABLES {{$opt_wait}} -t "$table" -X
  done
}

reset_iptables_v6() {
  $IP6TABLES {{$opt_wait}} -P OUTPUT  DROP
  $IP6TABLES {{$opt_wait}} -P INPUT   DROP
  $IP6TABLES {{$opt_wait}} -P FORWARD DROP

  for table in $FWF_TABLES; do
      list=$($IP6TABLES {{$opt_wait}} -t "$table" -L -n 2>/dev/null) || continue
      printf "%s" "$list" | while read -r c chain rest; do
      if test "$c" = "Chain" ; then
        $IP6TABLES {{$opt_wait}} -t "$table" -F "$chain"
      fi
      done
      $IP6TABLES {{$opt_wait}} -t "$table" -X
  done
}
