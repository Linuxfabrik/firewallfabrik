    <height>220</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>OpenAIS protocol settings</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab">
      <attribute name="title">
       <string>OpenAIS Parameters</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_2">
       <item row="0" column="0">
        <widget class="QLabel" name="openais_address_label">
         <property name="text">
          <string>Address:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1" colspan="2">
        <widget class="QLineEdit" name="openais_address">
         <property name="toolTip">
          <string>The multicast group the totem ring sends to, named by
mcastaddr in openais.conf or corosync.conf.  It has to
match, or the generated rules permit a group nothing sends
to and the ring never forms.  Leave empty for 226.94.1.1.
An IPv6 address is accepted and produces ip6tables rules.</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="openais_port_label">
         <property name="text">
          <string>Port number (UDP):</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QSpinBox" name="openais_port">
         <property name="toolTip">
          <string>The mcastport of the ring.  Corosync also listens one port
below this one, which the generated rules do not cover, so
a ring that does not form is worth checking here first.
Leave at 5405 unless the ring was configured otherwise.</string>
         </property>
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>65535</number>
         </property>
         <property name="value">
          <number>5405</number>
         </property>
        </widget>
       </item>
       <item row="1" column="2">
        <spacer name="horizontalSpacer">
         <property name="orientation">
          <enum>Qt::Orientation::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
