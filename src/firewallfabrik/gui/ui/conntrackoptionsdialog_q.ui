<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ConntrackOptionsDialog_q</class>
 <widget class="QDialog" name="ConntrackOptionsDialog_q">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>460</width>
    <height>240</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>conntrack protocol settings</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab">
      <attribute name="title">
       <string>conntrack Parameters</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_2">
       <item row="0" column="0" colspan="3">
        <widget class="QCheckBox" name="use_unicast">
         <property name="toolTip">
          <string>Tick this when conntrackd replicates over UDP unicast
rather than multicast.  There is then no group to permit,
so the rules name the other members' interfaces on the
sync link instead of the address below - which is also why
the other members have to be in the group before the rules
can be written.</string>
         </property>
         <property name="text">
          <string>Use unicast address for conntrackd</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="conntrack_address_label">
         <property name="text">
          <string>Address:</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1" colspan="2">
        <widget class="QLineEdit" name="conntrack_address">
         <property name="toolTip">
          <string>The multicast group conntrackd replicates to, the
IPv4_address of the Multicast block in conntrackd.conf.
It has to match, or the sync traffic is dropped and every
failover loses the connections it was meant to preserve.
Leave empty for 225.0.0.50, which conntrackd's own sample
configuration uses.  An IPv6 address is accepted and
produces ip6tables rules.</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="conntrack_port_label">
         <property name="text">
          <string>Port number (UDP):</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QSpinBox" name="conntrack_port">
         <property name="toolTip">
          <string>The Port of the Multicast block in conntrackd.conf.  Leave
at 3780, the port of the sample configuration, unless the
daemon was configured otherwise.  Port 0 is not offered:
the rule would permit a port nothing speaks.</string>
         </property>
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>65535</number>
         </property>
         <property name="value">
          <number>3780</number>
         </property>
        </widget>
       </item>
       <item row="2" column="2">
        <spacer name="horizontalSpacer">
         <property name="orientation">
          <enum>Qt::Orientation::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>140</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item row="3" column="0" colspan="3">
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
